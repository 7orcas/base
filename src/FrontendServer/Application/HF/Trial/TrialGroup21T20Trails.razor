@inherits BasePage
@attribute [Authorize]
@inject IDialogService DialogService;
@inject ConfigService ConfS

<div style="height:100%; display:flex; flex-direction:column; @GetDebugBorder("yellow")">

    @if (loadStatus.IsError)
    {
        <Error LoadStatus=@loadStatus>
            @loadStatus.Exception
        </Error>
    }
    else
    {
        <Loading LoadStatus=@loadStatus />
        
        <MudGrid Class="no-wrap-grid" Spacing="0" Style="@($"flex:1; min-height:0; height:0;{GetDebugBorder("orange")}")">

            @if (listUtil.ShowList)
            {
                <!-- Left Side List -->
                <MudItem xs="2" Style="height:100%; display:flex; flex-direction:column; min-height:0; max-width:300px;">
                    <MudPaper Elevation="0" Outlined="true" Style="flex:1; min-height:0; display:flex; flex-direction:column;">
                        <ListPanel TDto="TrialDto"
                                   List="@list" 
                                   CodeKey="Code"
                                   OnItemSelected="@OnItemSelected" />
                    </MudPaper>
                </MudItem>
            }
            <!-- Right Side Details -->
            <MudItem xs="10" Style="height:100%; display:flex; flex-direction:column; min-height:0;">
                <MudPaper Elevation="0" Outlined="false" Style="flex:1; min-height:0; overflow:auto; padding-right:20px;">
                    <TrialGroup21T21Detail Selections="listUtil.Selections"
                                          Refresh="@Refresh"
                                          PageStatus="@pageStatus" 
                                          FieldDefinitionUtil="@fieldDefinitionUtil"/>
                </MudPaper>
            </MudItem>

        </MudGrid>
    }
</div>


@using System.Net
@using MudBlazor
@using FrontendServer.Base.Util
@using GC = FrontendServer.GlobalConstants;
@using FrontendServer.Base._Base;
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.SignalR.Client;

@code {
    private List<ListModel<TrialDto>> list = new List<ListModel<TrialDto>>();
    private ListUtil<TrialDto> listUtil = new ListUtil<TrialDto>();
    private MudTable<ListModel<TrialDto>> _listTable;
    private FieldDefinitionUtil fieldDefinitionUtil;
    private TrialConfigDto _configDto;
    private HubConnection? _connection;


    [Parameter] public ListModel<TrialGroupDto> Selection { get; set; } = new ListModel<TrialGroupDto>(new TrialGroupDto());
    [Parameter] public EventCallback Refresh { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var defs = await GetDefinition(GetUrl("TrialDef"));
        fieldDefinitionUtil = new FieldDefinitionUtil(defs);
        _configDto = await GetAsync<TrialConfigDto>(GetUrl("TrialConfig"), false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitialiseBasePage();

            //Always make edit mode
            pageStatus.IsEditMode = pageStatus.orCrudCUD();

            //Add standard toolbar
            AddToolbarSearch(Search);
            if (pageStatus.isCrudC)
                AddToolbarAddNew(AddRecord);

           // AddToolbarExport(Export);

            if (pageStatus.isCrudU || pageStatus.isCrudC)
                AddToolbarSave(SaveAsync);

            Search();
            StateHasChanged();
        }
    }

    private async Task Search()
    {
        bool confirmed = true; 
        var ok = await ConfirmNavigationIsOk();
        if (!ok)
        {
            var result = await OpenConfirmYesNoDialog();
            confirmed = !result.Canceled;
        }

        if (confirmed)
        {
            var search = await GetAsync<TrialSearch>(GetUrl("TrialSearch"), false);
            search.TrailGroupId = Selection.Id;
            listUtil.Clear();
            await LoadList(search);

 //           var result = await OpenSearchDialog<TrialSearchDialog>();
 //           if (!result.Canceled)
 //           {
 //               listUtil.Clear();
 //               var data = (TrialSearch)result.Data;
 //               await LoadList(data);
 //           }
        }
    }

    
    private async Task LoadList(TrialSearch search)
    {
        var response = await PostAsync<_ResponseDto, TrialSearch>(GetUrl("TrialList"), search);

        list.Clear();
        List<TrialDto> listX = null;

        if (response.StatusCode == HttpStatusCode.OK)
        {
            var r = await response.Content.ReadAsStringAsync();
            var dto = JsonConvert.DeserializeObject<_ResponseDto>(r);

            if (dto.Valid)
                listX = JsonConvert.DeserializeObject<List<TrialDto>>(dto.Result.ToString());

        }

        if (listX == null)
            loadStatus.SetError();
        else
        {
            listUtil.ShowList = true;
            foreach (var u in listX)
            {
                list.Add(new ListModel<TrialDto>(u));
            }
        }

        if (list == null) { } //ToDo probably expired login
        else
        {
            if (list.Count > 0)
                LoadRecord(list[0]);
        }
        StateHasChanged();
    }

    private async Task OnItemSelected(ListModel<TrialDto> r)
    {
        await LoadRecord(r);
    }

    private async Task LoadRecord(ListModel<TrialDto> dto)
    {
        if (!dto.IsLoaded)
        {
            var record = await GetAsync<TrialDto>(GetUrlSlash("TrialGet") + dto.Id, false);
            dto.Load(record);
            await GetSingalRConnection(dto);
        }

        listUtil.Select(dto);
        StateHasChanged();
    }

    private async Task GetSingalRConnection(ListModel<TrialDto> sel)
    {
        try
        {
            var url = _configDto.TrialProgressHubUrl;
            var token = await ConfS.GetToken();

            _connection = new HubConnectionBuilder()
                .WithUrl(url, options =>
                {
                    options.AccessTokenProvider = () =>
                        Task.FromResult(token);
                })
                .WithAutomaticReconnect()
                .Build();

       
            _connection.On<TrialDto>(
                _configDto.TrialProgressChanged,
               dto =>
                {
                    sel.dto = dto;
                    InvokeAsync(StateHasChanged);
                });

            await _connection.StartAsync();

            await _connection.InvokeAsync(
                "Subscribe",
                sel.dto.Id.ToString());

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }

    }


    private async Task SaveAsync()
    {
        //Get records to be updated
        var updates = new List<ListModel<TrialDto>>();
        for (int i = 0; i < list.Count; i++)
        {
            var rec = list[i];
            rec.ResetValidation();
            if (rec.IsUpdateable())
                updates.Add(rec);
        }
        if (updates.Count == 0) return;

        loadStatus.SetSaving();

        var updatesX = new UpdateRequest<List<TrialDto>>()
        {
            Updates = updates.Select(x => x.dto).ToList()
        };
        var response = await PostAsync<List<TrialDto>>(GetUrl("TrialUpdate"), updatesX);

        var r2 = null as _ResponseDto;

        if (response.StatusCode == HttpStatusCode.OK)
        {
            var r1 = await response.Content.ReadAsStringAsync();
            r2 = JsonConvert.DeserializeObject<_ResponseDto>(r1);
        }
        else
        {
            //ToDo error response
            return;
        }



        if (r2.Valid)
        {
            List<TrialDto> dtos = JsonConvert.DeserializeObject<List<TrialDto>>(r2.Result.ToString());

            var deletes = new List<ListModel<TrialDto>>();
            for (int i = 0; i < list.Count; i++)
            {
                var rec = list[i];
                var recU = updates.FirstOrDefault(x => x.Id == rec.Id);

                if (recU == null) continue; 

                if (rec.IsDelete)
                {
                    deletes.Add(rec);
                    continue;
                }

                var dto = null as TrialDto;
                if (rec.IsNew())
                    dto = dtos.FirstOrDefault(x => x.Code == rec.dto.Code);
                else
                    dto = dtos.FirstOrDefault(x => x.Id == rec.Id);


                if (dto == null) continue;

                rec.ClearHash();
                rec.Load(dto);
            }

            foreach (var rec in deletes)
            {
                listUtil.Remove(rec);
                list.Remove(rec);
            }

        }
        else if (!string.IsNullOrEmpty(r2?.ErrorMessage))
        {
            loadStatus.ResetSaving();
            StateHasChanged();
            await OpenOkDialog(GetLabel("Error"), r2?.ErrorMessage);
        }
        else
        {
            List<ValidationDto> vals = r2?.Validations;
            for (int i = 0; i < updates.Count; i++)
            {
                var rec = updates[i];
                var val = vals != null ? vals.FirstOrDefault(x => x.Id == rec.Id) : null;
                if (val != null)
                {
                    rec.Validation = new ValidationModel
                    {
                        Validation = val
                    };
                }
            }
        }

        loadStatus.ResetSaving();
        StateHasChanged();
    }

    public async Task<bool> ConfirmNavigationIsOk()
    {
        for (int i = 0; list != null && i < list.Count; i++)
        {
            var dto = list[i];
            if (dto.IsLoaded && dto.HasChanged())
                return false;
        }
        return true;
    }

    private async Task AddRecord()
    {
        var dto = await GetAsync<TrialDto>(GetUrl("TrialNew"), false);
        var rec = new ListModel<TrialDto>(dto);
        rec.IsLoaded = true;
        list.Insert(0, rec);
        OnItemSelected(rec);
    }

    //ToDo
    private async Task Export()
    {

    }

}