@inherits BasePage
@inject NavigationManager NavigationManager

<div style="height:100%; overflow:auto;">

    <table style="flex:1; min-height:0; table-layout:fixed; width:100%;@GetDebugBorder("pink")">

        <tbody class="mud-table-body">
            <tr class="XXmud-table-row">
                @foreach (var record in Selections.Where(x => x.IsSelected))
                {
                var dto = record.dto;

                <td @key="record.Id" style="vertical-align: top; padding: 1px; background-color:white">

                    <MudExpansionPanels MultiExpansion="true">

                        @if (record.IsValidation())
                        {
                            <MudExpansionPanel @key="record" Text=@GetValidationLabel(record) Expanded=true Style="padding:1px;" Class="@GetValidationClass(record)">
                                <ChildContent>
                                    <ErrorPanel List="record.Validation.Messages" />
                                </ChildContent>
                            </MudExpansionPanel>
                        }

                        <MudExpansionPanel Text=@GetLabel("ConfigG") Expanded="true">
                            <TitleContent>
                                <div class="expansion-title">
                                    <div style="display:flex; justify-content:space-between; align-items:center;">
                                        <Label Size="GC.TextSize.Normal" Key="ConfigG"></Label>

                                        <div style="display:flex; gap:12px; align-items:center; margin-right:10px;">
                                            <CheckboxField Width=GC.TextFieldWidth.TextShort
                                                            Class="delete-checkbox"
                                                            LangCode="Delete"
                                                            ReadOnly="!IsDeleteActive"
                                                            @bind-Value="dto.IsDelete"
                                                            @bind-Value:after="OnDeleteChanged" />
                                        </div>
                                    </div>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                                    
                                    <TextField Width=GC.TextFieldWidth.TextShort
                                                LangCode="Code"
                                                ReadOnly="!dto.IsNew()"
                                                PageStatus=@PageStatus
                                                MaxLength="@GetMaxLength(nameof(dto.Code))"
                                                Required="@IsRequired(nameof(dto.Code))"
                                                Immediate="true"
                                                @bind-Value="@dto.Code"/>
                                    

                                    
                                    <TextField Width=GC.TextFieldWidth.TextLong
                                                LangCode="Desc"
                                                PageStatus=@PageStatus
                                                MaxLength="@GetMaxLength(nameof(dto.Description))"
                                                Required="@IsRequired(nameof(dto.Description))"
                                                Immediate="true"
                                                @bind-Value="@dto.Description"/>
                                    

                                    <MudText>@dto.StatusDescription</MudText>
                                    <MudText>@dto.Count</MudText>

                                    <MudButton OnClick="@(() => StartTrail(record))">
                                        <div class=" label label-no-link">
                                            <Label Key="StartTrailX"
                                                   Size="GC.TextSize.ButtonText"
                                                   HideTooltip=true>
                                            </Label>
                                        </div>
                                    </MudButton>



<p>@dto?.Count%</p>

                                    <Version version=dto />

                                </div>
                            </ChildContent>
                        </MudExpansionPanel>
                        

                    </MudExpansionPanels>
                </td>
            }
            </tr>
        </tbody>

    </table>
</div>

@using System.Net
@using MudBlazor
@using FrontendServer.Base.Util
@using GC = FrontendServer.GlobalConstants;
@using FrontendServer.Base._Base;
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.SignalR.Client;

@code {
    [Parameter] public List<ListModel<TrailDto>> Selections { get; set; } = new List<ListModel<TrailDto>>();
    [Parameter] public EventCallback Refresh { get; set; }
    
    private string GetAttemptsClass() => "error-row" + DarkModeSuffix();
    private HubConnection? _connection;    

    protected override async Task OnInitializedAsync()
    {
        _connection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/progressHub"))
            .WithAutomaticReconnect()
            .Build();

        _connection.On<TrailDto>(
            "ProgressChanged",
           dto =>
            {
                Selections[0].dto = dto;

                InvokeAsync(StateHasChanged);
            });

        await _connection.StartAsync();

        await _connection.InvokeAsync(
            "Subscribe",
            1.ToString());
    }


    private async Task StartTrail(ListModel<TrailDto> selected)
    {
        loadStatus.SetSaving();

        var response = await PostAsync<TrailDto>(GetUrl("StartTrail"), selected.dto);
        var r2 = null as _ResponseDto;

        if (response.StatusCode == HttpStatusCode.OK)
        {
            var r1 = await response.Content.ReadAsStringAsync();
            r2 = JsonConvert.DeserializeObject<_ResponseDto>(r1);
        }
        else
        {
            //ToDo error response
            return;
        }

        if (r2.Valid)
        {
            TrailDto dtoX = JsonConvert.DeserializeObject<TrailDto>(r2.Result.ToString());

            selected.dto = dtoX;

        }
        else
        {
            //   loadStatus.SetError();
            List<ValidationDto> vals = r2?.Validations;
                    
        }

        loadStatus.ResetSaving();
        StateHasChanged();
    }


}
