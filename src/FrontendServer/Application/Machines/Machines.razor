@attribute [Route(AppRoutes.MachinesRoute)]
@inherits BasePage
@attribute [Authorize]


<Header @key="pageStatus.pageCode"
        TitleKey="Machine"
        SubTitleKey="MachineSub"
        PageCode=@pageStatus.pageCode/>

@if (loadStatus.ShowSpinner())
{
    <Loading LoadStatus=@loadStatus>
        @loadStatus.Exception
    </Loading>

}
else
{
    <div style="margin-left:100px;">
        <MudGrid Class="mt-4">
            <MudPaper Elevation="0" Outlined="true">

                <Label Key="AddRecordXX"></Label>
                <Label Key="AddRecord"></Label>
        
                @if (machines != null)
                {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th><Label Key="Code"></Label></th>
                                    <th><Label Key="Desc"></Label></th>
                                    <th><Label Key="xDummy"></Label></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var machine in machines)
                                {
                                    <tr>
                                        <td>@machine.Code</td>
                                        <td>@machine.Description</td>
                                        <td></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                }
                <Label Key="Bottom"></Label>
             </MudPaper>
        </MudGrid>
    </div>
}



@using GC = FrontendServer.GlobalConstants;
@using Common.DTO.App;
@code {
    private List<MachineDto>? machines;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitialiseBasePage(GC.PerMachine);
            pageStatus.pageCode = AppRoutes.MachinesPageCode;
            machines = await GetAsync<List<MachineDto>>(GetUrl("MachineList"));

            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync() => loadStatus.IsLoading = true;
}