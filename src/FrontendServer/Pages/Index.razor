@page "/"
@page "/home"
@inherits BasePage

@if (_isLoading)
{
    <Spinner />
}
else @if (_isError)
{
    <AppError>
        @exception
    </AppError>
}
else
{
    <PageTitle>Index</PageTitle>

    <h1>Welcome to Blue.</h1>

    <p></p>
    <div class="message">@AutoError</div>
    <p></p>
    <p>
            <table style="border:solid; width:600px;table-layout:fixed;">
            <thead>
                    <tr><th style="width:100px;"></th><th></th></tr>
            </thead>
            <tbody>
                    <tr><td style="width:100px;">Org:</td><td><b>@ConfS?.Config?.Org.Nr: @ConfS?.Config?.Org.Code - @ConfS?.Config?.Org.Description</b></td></tr>
                    <tr style="background-color:#f0f0f0;"><td style="width:100px;">LangCode:</td><td><b>@ConfS.loginParameters?.lang</b></td></tr>
                    <tr><td style="width:100px;">LangVariant:</td><td><b>@ConfS.loginParameters?.langVariant</b></td></tr>
                    <tr style="background-color:#f0f0f0;"><td style="width:100px;">UserId:</td><td><b>@ConfS.loginParameters?.userId</b></td></tr>
                    <tr><td style="width:100px;">SessionId:</td><td><b>@ConfS.loginParameters?.sessionId</b></td></tr>
                    <tr style="background-color:#f0f0f0;"><td style="width:100px;">LoginUrl:</td><td><b>@ConfS.loginParameters?.loginUrl</b></td></tr>
                    <tr><td style="width:100px;">AppUrls:</td><td><b>@ConfS.loginParameters?.appUrls</b></td></tr>
                    @if (ConfS.loginParameters != null)
                    {
                        <tr style="background-color:#f0f0f0;"><td style="width:100px;">Loaded:</td><td><b>@((MarkupString)@ConfS.loginParameters?.loaded)</b></td></tr>
                    }
                    <tr><td style="width:100px;">Token key:</td><td><b>@ConfS.loginParameters?.tokenkey</b></td></tr>
                    <tr style="background-color:#f0f0f0;"><td style="width:100px;">Token:</td><td style="width:380px;overflow-wrap:break-word;word-break: break-all;white-space: normal;"><b>@ConfS.loginParameters?.token</b></td></tr>
            </tbody>
        </table>
        <div style="margin-top:10px;color:red;">@ConfS.loginParameters?.autoError</div>
    </p>
}

@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using sysJ = System.Text.Json
@using GC = FrontendServer.GlobalConstants;

@inject HttpClient HttpClient
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NM
@inject ProtectedSessionStorage PS
@inject ConfigService ConfS
@inject PermissionService PermS
@inject LabelService LS
@inject UrlService UrlS
@inject MenuService MenuS
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpContextAccessor

@code {

    public bool _isLoading = false;
    public bool _isError = false;
    public Exception? exception;
    public string AutoError = "";
    private bool _initialised;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        //if (firstRender && !_isError)
        if (_initialised)
            return;

        _initialised = true;

        await Initialise();
    }

    private async Task Initialise() {
        //Already logged in?
        var result = await PS.GetAsync<string>(GC.TokenCacheKey);
        if (result.Success)
        {
            await InitialiseBasePage(GC.PerIgnore);
            _isLoading = false;
            StateHasChanged();
            return;
        }

        var uri = NM.ToAbsoluteUri(NM.Uri);
        var fragment = uri.Fragment;

        if (string.IsNullOrEmpty(fragment))
        {
            _isLoading = false;
            _isError = true;
            StateHasChanged();
            return;
        }

        //Search the fragment for parameters
        var values = fragment.TrimStart('#')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Split('='))
            .Where(p => p.Length == 2)
            .ToDictionary(
                p => p[0],
                p => Uri.UnescapeDataString(p[1])
            );

        // Get the token key to use to get the actual token
        if (!values.TryGetValue("tk", out var tokenkey))
        {
            _isLoading = false;
            _isError = true;
            StateHasChanged();
            return;
        }

        var token = await GetTokenFromKey(tokenkey);
        await SetClient(token);

        // Get stuff
        if (!values.TryGetValue("appUrls", out var appUrls))
        {
            _isLoading = false;
            _isError = true;
            StateHasChanged();
            return;
        }
        await UrlS.ForceInitialise(appUrls);
        await MenuS.ForceInitialise();

        var config = await ConfS.Initialise();
        if (values.TryGetValue("urlLogin", out var urlLogin))
            config.UrlLogin = urlLogin;

        // Get App / User Config
        var lps = ConfS.SetLoginParameters(tokenkey, token, appUrls);
        lps.LoadedUrl(UrlS.GetUrl("ClientConfig"));
        SetConfig(config);
        await LS.ForceInitialise(lps);
        await PermS.ForceInitialise(lps);
        await GetVersion();
        _isLoading = false;

        // Auto open
        string url = null;
        if (values.TryGetValue("open", out var autoOpenX))
            url = await AutoOpen(autoOpenX, lps);

        if (string.IsNullOrEmpty(url))
            url = "/home?t=" + Guid.NewGuid();

        ConfS.loginParameters = lps;
        NM.NavigateTo(url, replace: true);

        StateHasChanged();
    }

    private async Task<string> GetTokenFromKey(string tokenkey)
    {
        var clientU = HttpClientFactory.CreateClient(GC.UnAuthorizedClientKey);
        var response = await clientU.GetAsync(GC.URL_token_token + "?key=" + tokenkey);
        var r = await response.Content.ReadAsStringAsync();
        var dto = JsonConvert.DeserializeObject<_ResponseDto>(r);
        var tokenDto = JsonConvert.DeserializeObject<LoginTokenDto>(dto.Result.ToString());
        await PS.SetAsync(GC.TokenCacheKey, tokenDto.AccessToken);
        await PS.SetAsync(GC.RefreshTokenCacheKey, tokenDto.RefreshToken);
        return tokenDto.AccessToken;
    }

    private async Task<HttpClient> SetClient(string token)
    {
        var client = HttpClientFactory.CreateClient(GC.AuthorizedClientKey);
        client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue(GC.BearerKey, token);
        return client;
    }

    private async Task<string> GetVersion()
    {
        var clientU = HttpClientFactory.CreateClient(GC.UnAuthorizedClientKey);
        var response = await clientU.GetAsync(GC.URL_version_number);
        var r = await response.Content.ReadAsStringAsync();
        var versionDto = JsonConvert.DeserializeObject<VersionDto>(r);
        var v = versionDto?.Version ?? "0";
        await PS.SetAsync(GC.VersionKey, v);
        return v;
    }

    private async Task<string> AutoOpen(string autoOpen, LoginParameters lps)
    {
        int? permissionNr = AppRoutes.GetPermissionNr(autoOpen);
        bool isRouteValid = AppRoutes.IsRoute(autoOpen);
        bool isPermitted = isRouteValid && permissionNr != null && (permissionNr == -1 || PermS.IsPermission(permissionNr.Value));
        string error = null;

        if (!isRouteValid)
            error = "Invalid route";
        else if (!isPermitted)
            error = LS.GetLabel("NAuthX");

        if (!string.IsNullOrEmpty(error))
        {
            _isLoading = false;
            _isError = true;
            error += ": '" + autoOpen + "'";
            lps.autoError = error;
            await OpenOkDialog(LS.GetLabel("Error"), error);
        }
        else if (isPermitted && isRouteValid)
            return "/" + AppRoutes.GetRoute(autoOpen);

        return null;
    }


    protected override async Task OnInitializedAsync() => _isLoading = true;

}
