@inherits BasePage

<MudDialog Class="search-dialog" Style="@($"width:{Width} !important; min-width:{Width} !important")">
    <TitleContent>
        <div class="d-flex align-center w-100">
            <div class="d-flex align-center">
                <MudText Typo="Typo.h6" Class="flex-grow-1">
                    @GetLabel(TitleKey)
                </MudText>

                <MudIconButton Style="color:white;"
                               Icon="@Icons.Material.Filled.Settings"
                               OnClick="ToggleAdvancedPanel"
                               Class="mr-2" />
            </div>

            <MudSpacer />

            <MudButton Variant="Variant.Filled"
                       Class="cancel-button"
                       OnClick="@CloseDialog">
                @GetLabel("Cancel")
            </MudButton>
        </div>
    </TitleContent>

    <DialogContent>
        <div @onkeydown="HandleKeyDown" style="@($"height:{ComputedHeight}; overflow-y:auto;")">

            <MudForm >
                @if (ShowAdvancedPanel)
                {
                    <div style="border: 1px solid black; padding: 10px; margin-bottom:10px;">
                        
                        <div class="d-flex align-center">   
                            <MudText Class="mr-4">
                                @GetLabel("TextS"):
                            </MudText>

                            <MudRadioGroup T="GC.TextSearchCompare"
                                           @bind-Value="BaseSearch.TextFieldSearchType"
                                           Class="d-flex flex-row">

                                <MudRadio Value="GC.TextSearchCompare.Contains" Class="mr-4">
                                    @GetLabel("TextSC")
                                </MudRadio>

                                <MudRadio Value="GC.TextSearchCompare.Start" Class="mr-4">
                                    @GetLabel("TextSS")
                                </MudRadio>

                                <MudRadio Value="GC.TextSearchCompare.Exact">
                                    @GetLabel("TextSE")
                                </MudRadio>

                            </MudRadioGroup>
                        </div>

                        <div class="d-flex align-center">
                            <MudText Class="mr-4">
                                @GetLabel("TextD"):
                            </MudText>

                            <MudRadioGroup T="GC.TextSearchDelimiter"
                                           @bind-Value="BaseSearch.TextFieldDelimiterType"
                                           Class="d-flex flex-row">

                                <MudRadio Value="GC.TextSearchDelimiter.None" Class="mr-4">
                                    @GetLabel("TextDN")
                                </MudRadio>

                                <MudRadio Value="GC.TextSearchDelimiter.Or" Class="mr-4">
                                    @GetLabel("TextDO")
                                </MudRadio>

                            </MudRadioGroup>
                        </div>


                        <div class="d-flex align-center">
                            <CheckboxField Width=GC.TextFieldWidth.TextMedium
                                       LangCode="Unaccent"
                                       @bind-Value="BaseSearch.IsTextFieldSearchUnaccent"/>

                            <CheckboxField LangCode="SearchRM"
                                       @bind-Value="BaseSearch.RememberSearch" />
                        </div>
                    </div>
                }

                @ChildContent

                @if (ShowActiveChoiceX())
                {
                    <div class="d-flex align-center">
                        <CheckboxField Width=GC.TextFieldWidth.TextVeryShort
                                       LangCode="Active"
                                       @bind-Value="BaseSearch.IncludeActive"/>

                        <CheckboxField Width=GC.TextFieldWidth.TextVeryShort
                                       LangCode="InActive"
                                       @bind-Value="BaseSearch.IncludeInActive" />
                    </div>
                }
            </MudForm>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="d-flex align-center w-100" 
             style="margin-left:10px;margin-right:10px">

            @if (@BaseSearch.MaxRecordsReturned > 0)
            {

                <MudText Class="mr-2">
                    @GetLabel("MaxSR"):&nbsp;
                </MudText>

                @if (!@IsReadOnly)
                {
                    <MudNumericField T="int"
                    Class="maxsr-field"
                    HideSpinButtons="true"
                    ReadOnly="@IsReadOnly"
                    Dense="true"
                    Style="width:70px"
                    @bind-Value="BaseSearch.MaxRecordsReturned" />
                }
                else
                {
                    <MudText Class="mr-2">
                        @BaseSearch.MaxRecordsReturned
                    </MudText>
                }
            }

            <MudSpacer />

            <MudButton Variant="Variant.Filled"
                       Class="submit-button"
                       Disabled="!IsValid"
                       OnClick="SubmitAction">
                @GetLabel("Search")
            </MudButton>

        </div>
    </DialogActions>
</MudDialog>

@using GC = FrontendServer.GlobalConstants;

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public string Width { get; set; } = "700px";
    [Parameter] public string Height { get; set; } = "500px";
    [Parameter] public string TitleKey { get; set; } = "Search";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback SubmitAction { get; set; } = new();
    [Parameter] public int MaxRecordsReturned { get; set; } = 500;
    [Parameter] public bool IsService { get; set; } = false;
    [Parameter] public bool ShowActiveChoice { get; set; } = false;
    [Parameter] public _BaseSearch BaseSearch { get; set; } 
    [Parameter] public bool IsValid { get; set; } = true;

    private void CloseDialog() => MudDialog.Cancel();
    private bool IsReadOnly => IsService ? false : true;

    private void OnBlu(){}

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SubmitAction.InvokeAsync();
    }

    private bool ShowActiveChoiceX() => ShowActiveChoice || BaseSearch.ShowActive;

    private bool ShowAdvancedPanel = false;
    private void ToggleAdvancedPanel() 
    {
        ShowAdvancedPanel = !ShowAdvancedPanel;
        StateHasChanged();
    }

    private string ComputedHeight
    {
        get
        {
            var h = int.Parse(Height.Replace("px", ""));
            return $"{h + (ShowAdvancedPanel ? 100 : 0)}px";
        }
    }

}
