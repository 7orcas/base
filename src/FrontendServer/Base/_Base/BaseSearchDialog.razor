@inherits BasePage

<MudDialog Class="search-dialog" Style="width:700px; height:500px;">
    <TitleContent>
        <div class="d-flex align-center w-100">
            <MudText Typo="Typo.h6" Class="flex-grow-1">
                @GetLabel(TitleKey)
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       OnClick="@CloseDialog">
                @GetLabel("Cancel")
            </MudButton>
        </div>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            @ChildContent
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!success)"
                   Class="ml-auto"
                   OnClick="Submit">
            @GetLabel("Search")
        </MudButton>

    </DialogActions>
</MudDialog>


@using GC = FrontendServer.GlobalConstants;

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    [CascadingParameter] private string TitleKey { get; set; } = "Search";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? username = "user";

    private bool success = true;

    MudForm form;
    MudTextField<string> usernameField;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitialiseBasePage(GC.PerUser);


            await Task.Delay(100);
            //  await usernameField!.FocusAsync();

            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync() => _isLoading = true;

    private void CloseDialog()
    {
        MudDialog.Cancel();
    }

    
    private void OnBlu()
    {

    }

    private async Task Submit()
    {
        await form.Validate();
        if (success)
        {
            MudDialog.Close(DialogResult.Ok(new SearchData
            {
                Username = username,
                //Email = Email
            }));
        }
        else
        {
            Console.WriteLine("Form is invalid.");
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Submit();
    }


    public class SearchData
    {
        public string Username { get; set; }
        public string Email { get; set; }
    }


}
