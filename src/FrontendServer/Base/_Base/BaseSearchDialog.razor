@inherits BasePage

<MudDialog Class="search-dialog" Style="@($"width:{Width}; height:{Height};")">
    <TitleContent>
        <div class="d-flex align-center w-100">
            <MudText Typo="Typo.h6" Class="flex-grow-1">
                @GetLabel(TitleKey)
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       OnClick="@CloseDialog">
                @GetLabel("Cancel")
            </MudButton>
        </div>
    </TitleContent>

    <DialogContent>
        <div @onkeydown="HandleKeyDown">
            <MudForm >
                @ChildContent

                @if (!ShowActiveChoice)
                {
                    <div class="d-flex align-center">
                        <CheckboxField Width=GC.TextFieldWidth.TextVeryShort
                                       LangCode="Active"
                                       @bind-Value="BaseSearch.IncludeActive"/>

                        <CheckboxField Width=GC.TextFieldWidth.TextVeryShort
                                       LangCode="InActive"
                                       @bind-Value="BaseSearch.IncludeInActive" />
                    </div>
                }
            </MudForm>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="d-flex align-center w-100">

            @if (@BaseSearch.MaxRecordsReturned > 0)
            {

                <MudText Class="mr-2">
                    @GetLabel("MaxSR"):&nbsp;
                </MudText>

                @if (!@IsReadOnly)
                {
                    <MudNumericField T="int"
                    Class="maxsr-field"
                    HideSpinButtons="true"
                    ReadOnly="@IsReadOnly"
                    Dense="true"
                    Style="width:70px"
                    @bind-Value="BaseSearch.MaxRecordsReturned" />
                }
                else
                {
                    <MudText Class="mr-2">
                        @BaseSearch.MaxRecordsReturned
                    </MudText>
                }
            }

            <MudSpacer />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="!IsValid"
                       Class="ml-auto"
                       OnClick="SubmitAction">
                @GetLabel("Search")
            </MudButton>

        </div>
    </DialogActions>
</MudDialog>

@using GC = FrontendServer.GlobalConstants;

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public string Width { get; set; } = "700px";
    [Parameter] public string Height { get; set; } = "500px";
    [Parameter] public string TitleKey { get; set; } = "Search";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback SubmitAction { get; set; } = new();
    [Parameter] public int MaxRecordsReturned { get; set; } = 500;
    [Parameter] public bool IsService { get; set; } = false;
    [Parameter] public bool ShowActiveChoice { get; set; } = false;
    [Parameter] public _BaseSearch BaseSearch { get; set; } 
    [Parameter] public bool IsValid { get; set; } = true;

    private void CloseDialog() => MudDialog.Cancel();
    private bool IsReadOnly => IsService ? false : true;

    private void OnBlu(){}

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SubmitAction.InvokeAsync();
    }

}
