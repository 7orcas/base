@inject LabelService LS
@inject ConfigService CS
@inject ThemeService TS
@using MudBlazor
@using GC = FrontendServer.GlobalConstants;

@code {
    [Parameter] public PageStatus? PageStatus { get; set; }
    [Parameter] public FieldDefinitionUtil? FieldDefinitionUtil { get; set; } = new FieldDefinitionUtil(null);

    public static string loading = "..loading";
    public MudBlazor.Variant MudVariant = MudBlazor.Variant.Outlined;

    public string GetStyle(GC.TextFieldWidth width)
    {
        string s = width switch
        {
            GC.TextFieldWidth.Ignore => "",
            GC.TextFieldWidth.TextVeryShort => "width: 100px;",
            GC.TextFieldWidth.TextShort => "width: 200px;",
            GC.TextFieldWidth.TextMedium => "width: 400px; max-width: 400px;",
            GC.TextFieldWidth.TextLong => "width: 600px;",
            GC.TextFieldWidth.Int => "width: 100px;",
            _ => "width: 500px;"
        };

        if (CS.IsDebugMode)
            s += " border: 1px dashed lightgray;";

        return s;
    }

    public Typo GetTypo(GC.TextSize size) => size switch
    {
        GC.TextSize.Heading => Typo.h3,
        GC.TextSize.SubHeading => Typo.h4,
        GC.TextSize.Section => Typo.h5,
        GC.TextSize.Large => Typo.h6,
        GC.TextSize.Small => Typo.body2,
        GC.TextSize.ButtonText => Typo.h6,
        _ => Typo.body1
    };


    public string GetClass(bool isReadOnly)
    {

        string s = "component-";

        if (isReadOnly)
            s += "ro-";
        else s += "ed-";
        if (TS.IsDarkMode)
            s += "dark";
        else s += "light";

        return s;
    }

    public void OnDeleteChanged()
    {
        StateHasChanged();
    }

    public string GetValidationLabel<T>(ListModel<T> record) where T : Common.DTO._BaseDto
    {
        if (record.Validation.MessageCount > 1)
            return GetLabel("ValMs");
        return GetLabel("ValM");
    }

    public string GetValidationClass<T>(ListModel<T> record) where T : Common.DTO._BaseDto
    {
        if (record.IsValidationError())
            return "error-row" + DarkModeSuffix();

        if (record.IsValidationWarning())
            return "warning-row" + DarkModeSuffix();

        return string.Empty;
    }


    public string GetDebugBorder(string color)
    {
        if (CS.Config == null) return string.Empty;
        return CS.IsDebugBorder ? " border:5px solid " + color + ";" : string.Empty;
    }

    public LabelService GetLabelService() => LS;

    //Field Config methods
    public int GetMaxLength(string name) => FieldDefinitionUtil.MaxLength(name);
    public bool IsRequired(string name) => FieldDefinitionUtil.IsRquired(name);
    public bool IsRquiredNew(string name, bool isNew) => isNew && FieldDefinitionUtil.IsRquiredNew(name);
    public bool IsServiceOnly(string name) => FieldDefinitionUtil.IsServiceOnly(name) && CS.Config.User.IsService;

    //Convenience methods
    public AppConfigDto GetConfig() => CS.Config;
    public bool IsLabel(string labelCode) => LS.IsLabel(labelCode);
    public bool IsTooltip(string labelCode) => LS.IsTooltip(labelCode);
    public bool IsEditMode() => PageStatus?.IsEditMode ?? true;
    public string GetLabel(string labelCode) => LS.GetLabel(labelCode);
    public string GetLabelHighlightNoKey(string labelCode) => LS.GetLabelHighlightNoKey(labelCode);
    public string? GetTooltip(string labelCode) => LS.GetTooltip(labelCode);
    public string DarkModeSuffix() => TS.IsDarkMode? "-dark" : "-light";
    public bool IsEditActive => PageStatus == null ? false : PageStatus.IsEditMode;
    public bool IsDeleteActive => PageStatus == null ? false : PageStatus.isCrudD;
    
}
