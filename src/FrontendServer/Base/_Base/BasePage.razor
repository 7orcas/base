@inherits BaseComponent

@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using GC = FrontendServer.GlobalConstants;

@inject IDialogService DialogService
@inject ProtectedSessionStorage PS
@inject CacheService CS
@inject ConfigService ConfS
@inject LabelService LS
@inject PermissionService PermS
@inject HttpService HS
@inject ThemeService TS

@code {
    [Inject] protected IJSRuntime JS { get; set; }

    public LoadStatus loadStatus = new LoadStatus(); //This will replace the attributes below
    //DELETE ME
    public bool _isLoading = false;
    public bool _isError = false;
    public bool _isSaving = false;
    public int? _statusCode;
    public MarkupString? _errorMessage;
    public Exception? exception;

    public bool _stateChangedToggle = false;
    public bool _isValidationError = false;
    public bool _isCrudC = false;
    public bool _isCrudR = false;
    public bool _isCrudU = false;
    public bool _isCrudD = false;
    public bool _isCrudRO = true;
    public string? _pageCode;
    public string? _entityLangKey;
    private string? _token;
    //public ErrorBoundary? errorBoundary;
    private AppConfigDto _config;
    private Dictionary<string, LangLabelDto> _labels;
    public List<ToolBarButton> toolBarButtonsLeft = new List<ToolBarButton>();
    public List<ToolBarButton> toolBarButtonsRight = new List<ToolBarButton>();


    //Debugging
    public bool _debugOutlined = false;

    public async Task InitialiseBasePage()
    {
        var pageCodeAttr = GetType()
                    .GetCustomAttributes(typeof(PageCodeAttribute), true)
                    .Cast<PageCodeAttribute>()
                    .FirstOrDefault();
        _pageCode = pageCodeAttr?.Code;

        var permAttr = GetType()
                        .GetCustomAttributes(typeof(PagePermissionAttribute), true)
                        .Cast<PagePermissionAttribute>()
                        .FirstOrDefault();

        await InitialiseBasePage(permAttr?.Code ?? GC.PerIgnore, null);
    }


    public async Task InitialiseBasePage(int permissionNr) => await InitialiseBasePage(permissionNr, null);

    public async Task InitialiseBasePage(int permissionNr, string? entityLangKey)
    {
        if (!ConfS.IsInitialized)
        {
            await ConfS.Initialise();
            string? t = await ConfS.GetToken();
            ConfS.SetLoginParameters(null, t);
        }

        if (!LS.IsInitialized)
            await LS.Initialise(ConfS.loginParameters);

        _config = ConfS.Config;
        _labels = LS.Labels;
        _entityLangKey = entityLangKey;

        if (permissionNr != GC.PerIgnore)
            SetCrud(permissionNr);
    }

    //Force an update
    public void ForceStateHasChanged()
    {
        _stateChangedToggle = !_stateChangedToggle;
        StateHasChanged();
    }


    public void AddToolbarEdit(Func<Task> edit, Func<string> label) => toolBarButtonsLeft.Add(new ToolBarButton
    {
        GetLabel = label,
        Action = edit,
    });
    public void AddToolbarAddNew(Func<Task> addNew) => toolBarButtonsLeft.Add(new ToolBarButton
    {
        LangKey = "AddN",
        Action = addNew
    });
    public void AddToolbarSearch(Func<Task> search) => toolBarButtonsLeft.Add(new ToolBarButton
    {
        LangKey = "Search",
        Action = search
    });
    public void AddToolbarSave(Func<Task> save) => toolBarButtonsRight.Add(new ToolBarButton
    {
        LangKey = "SaveChg",
        Action = save,
        Class = "toolbar-button-highlight"
    });
    public void AddToolbarExport(Func<Task> export) => toolBarButtonsRight.Add(new ToolBarButton 
    { 
        LangKey = "Export", 
        Action = export 
    });



    //DarkMode
    protected override void OnInitialized() => TS.OnThemeChanged += OnThemeChanged;
    private void OnThemeChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => TS.OnThemeChanged -= OnThemeChanged;

    //Permissions
    public void SetCrud (int permissionNr)
    {
        if (ConfS.Config.User.IsService)
        {
            _isCrudC = _isCrudR = _isCrudU = _isCrudD = true;
            _isCrudRO = false;
            return;
        }

        _isCrudRO = true;

        var p = PermS.GetPermission(permissionNr);
        if (p == null || 
            string.IsNullOrEmpty(p.Crud)) return;

        _isCrudC = p.Crud.Contains(GC.CrudCreate);
        _isCrudR = p.Crud.Contains(GC.CrudRead);
        _isCrudU = p.Crud.Contains(GC.CrudUpdate);
        _isCrudD = p.Crud.Contains(GC.CrudDelete);
        _isCrudRO = !_isCrudC && !_isCrudU && !_isCrudD;
    }


    public MarkupString AppendMarkupString(MarkupString m, string s)
    {
        if (string.IsNullOrEmpty(m.ToString()))
            return new MarkupString(s);

        return new MarkupString(m.ToString() + "<br>" + s);
    }

    public void PutCacheString(string key, string s) => CS.PutString(key + "-" + _config.UniqueSessionId, s);
    public string? GetCacheString(string key) => CS.GetString(key + "-" + _config.UniqueSessionId);
    public string GetListRowOddEvenClass(int i) => (i % 2 == 0 ? " list-odd-row" : " list-even-row") + GetLightDarkClassSuffix();
    public string GetSelectRowPointer(bool selected) => selected ? "*" : "";
    public string GetSelectRowClass(bool selected) => selected ? " selected-row" : "";
    public string GetFirstColumnErrorClass(_BaseDto dto) => dto.IsError ? "first-colum-error" + GetLightDarkClassSuffix() : "";   
    public string GetLightDarkClassSuffix() => TS.IsDarkMode ? "-dark" : "-light";

    public string GetListColumnErrorClass<T>(ListModel<T> model) where T : _BaseDto
    {
        return model.IsError
            ? "first-colum-error" + GetLightDarkClassSuffix()
            : "";
    }

    public string GetListSelectRowPointer(bool isSelected) 
    {
        return isSelected ? "*" : "";
    }
    public string GetListSelectRowClass(bool isSelected)
    {
        return isSelected ? " selected-row" : "";
    }

    public string GetListSelectRowPointer<T>(ListModel<T> model, List<ListModel<T>> selections) where T : _BaseDto
    {
        return Contains(model, selections) ? "*" : "";
    }

    public string GetListSelectRowClass<T>(ListModel<T> model, List<ListModel<T>> selections) where T : _BaseDto
    {
        return Contains(model, selections) ? " selected-row" : "";
    }

    public bool Contains<T>(ListModel<T> model, List<ListModel<T>> selections) where T : _BaseDto
    {
        return selections.Any(x => x.Id == model.Id);
    }

}