@inherits BaseComponent

@using System.Linq.Expressions
@using MudBlazor
@using GC = FrontendServer.GlobalConstants;

<MudNumericField Style="@GetStyle(Width)"
                 Class="@GetClassLocal()"
                 Label="@label"
                 ReadOnly="@IsReadOnly"
                 Immediate="@Immediate"
                 Value="@Value"
                 ValueChanged="@ValueChanged"
                 ValueExpression="@ValueExpression"
                 Variant=@MudVariant />

@code {
    [Parameter] public string LangCode { get; set; }
    [Parameter] public GC.TextFieldWidth Width { get; set; } = GC.TextFieldWidth.Int;
    [Parameter] public bool ReadOnly { get; set; } = false;
    [Parameter] public bool Immediate { get; set; } = false;
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public Expression<Func<int>> ValueExpression { get; set; }

    private bool IsReadOnly => ReadOnly ? true : (!PageStatus?.IsEditMode ?? false);

    private string label = loading;
    protected override void OnInitialized() => label = GetLabel(LangCode);

    private string GetClassLocal()
    {
        var clazz = GetClass(IsReadOnly);

        if (!ReadOnly && IsEditMode() && Required)
            clazz += " red-border";

        return clazz;
    }
}
