@inherits BaseComponent

@using System.Linq.Expressions
@using MudBlazor
@using GC = FrontendServer.GlobalConstants;

<MudCheckBox Style="@GetStyle()"
             Class="@GetClassLocal()"
             Label="@label"
             ReadOnly="@IsReadOnly"
             Value="@Value"
             ValueChanged="@ValueChanged"
             ValueExpression="@ValueExpression"
             Variant=@MudVariant />

@code {
    [Parameter] public string LangCode { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public GC.TextFieldWidth Width { get; set; } = GC.TextFieldWidth.TextShort;
    [Parameter] public bool Value { get; set; }
    [Parameter] public bool ReadOnly { get; set; } = false;
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public Expression<Func<bool>> ValueExpression { get; set; }

    private string label = loading;
    protected override void OnInitialized() => label = GetLabel(LangCode);

    private bool IsReadOnly => ReadOnly ? true : (!PageStatus?.IsEditMode ?? false);
    
    private string GetClassLocal()
    {
        var clazz = GetClass(IsReadOnly);
        clazz += " " + (!string.IsNullOrEmpty(Class) ? Class + DarkModeSuffix() : "");

        clazz += " text-field text-field-" + GetWidthPx(Width) + " ";

        return clazz;
    }
}
