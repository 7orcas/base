@inherits BasePage

<BaseSearchDialog Width="800px"
                  Height="500px"
                  TitleKey="AuditSr"
                  SubmitAction="Submit"
                  IsValid="data.IsValid()"
                  BaseSearch="data"
                  MaxRecordsReturned="MaxRecordsReturned"
                  IsService="IsService">

    
    <TextField Width=GC.TextFieldWidth.TextMedium
               LangCode="UserName"
               MaxLength="@GC.LenCode"
               @ref="usernameField"
               @bind-Value="data.Username" />

    <TextField Width=GC.TextFieldWidth.TextMedium
               LangCode="Entity"
               MaxLength="@GC.LenCode"
               @bind-Value="data.EntityType" />

    <NumericNullField TValue="long?"
                      Width=GC.TextFieldWidth.TextMedium
                      LangCode="EntityId"
                      Value="@data.EntityId"
                      ValueChanged="@((long? val) => data.EntityId = val)"
                      ValueExpression="() => data.EntityId" />

    <CrudSelect @bind-Crud="data.CRUD" />

    <MudStack Row="true" Spacing="2">
        <DateField LangCode="FromD"
                   Date="data.FromDate"
                   DateChanged="OnFromDateChanged" />

        <TimeField LangCode="FromT"
                   Time="data.FromTime"
                   TimeChanged="OnFromTimeChanged" />
    </MudStack>

    <DateField LangCode="ToD"
               Date="data.ToDate" 
               DateChanged="OnToDateChanged" />


</BaseSearchDialog>


@using GC = FrontendServer.GlobalConstants;

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public int MaxRecordsReturned { get; set; }
    [Parameter] public bool IsService { get; set; }

    private AuditSearch data = new AuditSearch();
    private TextField usernameField;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            data = await GetAsync<AuditSearch>(GC.URL_audit_search, false);
            data.MaxRecordsReturned = MaxRecordsReturned;      
            StateHasChanged();
        }
    }

    private Task OnFromDateChanged(DateTime? date)
    {
        data.FromDate = date;
        return Task.CompletedTask;
    }

    private Task OnToDateChanged(DateTime? date)
    {
        data.ToDate = date;
        return Task.CompletedTask;
    }

    private Task OnFromTimeChanged(TimeSpan? time)
    {
        data.FromTime = time;
        return Task.CompletedTask;
    }

    private async Task Submit()
    {
        if (data.IsValid())
        {
            MudDialog.Close(DialogResult.Ok(data));
        }
    }

}
