@inherits BasePage
@using MudBlazor
@using System.Text.Json
@using FrontendServer.Base._Base;
@using GC = FrontendServer.GlobalConstants;

<div style="height:100%; overflow:auto;">

    <table style="flex:1; min-height:0; table-layout:fixed; width:100%;@GetDebugBorder("pink")">

        <tbody class="mud-table-body">
            <tr class="XXmud-table-row">
                @foreach (var record in Selections.Where(x => x.IsSelected))
                {
                var dto = record.dto;

                <td @key="record.Id" style="vertical-align: top; padding: 1px; background-color:white">
                    @if (string.IsNullOrWhiteSpace(dto.Details))
                    {
                        <MudText Color="Color.Secondary">
                            @GetLabel("AuditND")
                        </MudText>
                    }
                    else if (dto.Activity == GC.CrudUpdate)
                    {
                        <MudText>
                            @GetLabel("Updates"):
                        </MudText>
                        <pre style="font-family: inherit; font-size: inherit; margin: 0;">
                            @dto.Details
                        </pre>
                    }
                    else
                    {
                        var json = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(dto.Details);
                        @if (json != null)
                        {
                            @foreach (var kvp in json)
                            {
                                <div>
                                    <strong>@kvp.Key:</strong>

                                    @if (kvp.Value.ValueKind == JsonValueKind.Array ||
                                            kvp.Value.ValueKind == JsonValueKind.Object)
                                    {
                                        <pre style="font-family: inherit; font-size: inherit; margin: 0;">
                                            @JsonSerializer.Serialize(
                                            JsonSerializer.Deserialize<object>(kvp.Value.GetRawText()),
                                            new JsonSerializerOptions { WriteIndented = true })
                                        </pre>
                                    }
                                    else
                                    {
                                        @kvp.Value.ToString()
                                    }
                                </div>
                            }
                        }
                    }
                </td>
            }
            </tr>
        </tbody>

    </table>
</div>



@code {
    [Parameter] public List<ListModel<AuditDto>> Selections { get; set; } = new List<ListModel<AuditDto>>();
}