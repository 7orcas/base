@inherits BasePage
@attribute [Route(BaseRoutes.AuditRoute)]
@attribute [PageCode(BaseRoutes.AuditPageCode)]
@attribute [PagePermission(GC.PerAudit)]
@attribute [Authorize]


<ConfirmNavigation List="list" />

<div style="height:100%; display:flex; flex-direction:column; @GetDebugBorder("yellow")">

    <HeaderThin @key=pageStatus.pageCode
            TitleKey="Audit"
            PageCode=@pageStatus.pageCode
            PageStatus="@pageStatus"
            ToolBarButtonsLeft="toolBarButtonsLeft"
            ToolBarButtonsRight="toolBarButtonsRight" />

    <div style="margin-top:10px; border-bottom: 1px solid #ccc; margin-bottom:2px;"></div>

    @if (loadStatus.IsError)
    {
        <Error LoadStatus=@loadStatus>
            @exception
        </Error>
    }
    else
    {
        <Loading LoadStatus=@loadStatus />
        
        <MudGrid Class="no-wrap-grid" Spacing="0" Style="@($"flex:1; min-height:0; height:0;{GetDebugBorder("orange")}")">
            <MudItem xs="10" Style="height:100%; display:flex; flex-direction:column; min-height:0; max-width:800px;">
                <MudPaper Elevation="0" Outlined="true" Style="flex:1; min-height:0; display:flex; flex-direction:column;">
                    <AuditListPanel 
                               List="@list"
                               OnItemSelected="@OnItemSelected" />
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</div>

@using System.Net
@using MudBlazor
@using FrontendServer.Base.Util
@using GC = FrontendServer.GlobalConstants;
@using FrontendServer.Base._Base;
@using Newtonsoft.Json;
@inject IDialogService DialogService

@code {
    private List<ListModel<AuditDto>> list = new List<ListModel<AuditDto>>();
    private ListUtil<AuditDto> listUtil = new ListUtil<AuditDto>();
    private MudTable<ListModel<AuditDto>> _listTable;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitialiseBasePage();

            //Add standard toolbar
            AddToolbarSearch(Search);
         
            Search();
            StateHasChanged();
        }
    }

    private async Task Search()
    {
        var result = await OpenSearchDialog<AuditSearchDialog>();
        if (!result.Canceled)
        {
            listUtil.Clear();
            var data = (AuditSearch)result.Data;
            await Load(data);
        }
    }

    private async Task Load(AuditSearch search)
    {
        var response = await PostAsync<_ResponseDto, AuditSearch>(GC.URL_audit_list, search);

        list.Clear();
        List<AuditDto> listX = null;

        if (response.StatusCode == HttpStatusCode.OK)
        {
            var r = await response.Content.ReadAsStringAsync();
            var dto = JsonConvert.DeserializeObject<_ResponseDto>(r);
            if (dto.Valid)
                listX = JsonConvert.DeserializeObject<List<AuditDto>>(dto.Result.ToString());

        }

        if (listX == null)
            loadStatus.SetError();
        else
        {
            listUtil.ShowList = true;
            foreach (var u in listX)
            {
                list.Add(new ListModel<AuditDto>(u));
            }
        }

        StateHasChanged();

        // if (list == null) { } //ToDo probably expired login
        // else
        // {
        //     if (list.Count > 0)
        //         Load(list[0]);
        // }

    }

    private async Task OnItemSelected(ListModel<AuditDto> r)
    {
        //await Load(r);
    }

}