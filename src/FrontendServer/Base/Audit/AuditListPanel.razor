@inherits BasePage
@using MudBlazor
@using GC = FrontendServer.GlobalConstants;
@using FrontendServer.Base._Base;

<div style="height:100%; display:flex; flex-direction:column; min-height:0;">

    <MudTable Style="@($"flex:1; min-height:0; table-layout:fixed; width:100%; {@GetDebugBorder("blue")}")"
              T="ListModel<AuditDto>"
              Items="@List"
              Filter="Filter"
              Height="100%"
              FixedHeader="true"
              Hover="true"
              Bordered="true"
              Striped="true">

        <ColGroup>
            <col style="width:10%;" />
            <col style="width:15%;" />
            <col style="width:10%;" />
            <col style="width:20%;" />
            <col style="width:20%;" />
            <col style="width:20%;" />
        </ColGroup>
        <HeaderContent>
            <MudTh><Label Key="Source" /></MudTh>
            <MudTh>
                <div style="display:flex; flex-direction:column;">
                    <div style="display:flex; align-items:center;">
                        <Label Key="Entity" />
                        <TableColumnFilterIcon Filter="filter" FilterName="Entity" />
                    </div>
                    <TableColumnFilterInput Filter="filter" FilterName="Entity" />
                </div>
            </MudTh>
            <MudTh><Label Key="Id" /></MudTh>
            <MudTh>
                <div style="display:flex; flex-direction:column;">
                    <div style="display:flex; align-items:center;">
                        <Label Key="UserName" />
                        <TableColumnFilterIcon Filter="filter" FilterName="Username" />
                    </div>
                    <TableColumnFilterInput Filter="filter" FilterName="Username" />
                </div>
            </MudTh>
            <MudTh><Label Key="Created" /></MudTh>
            <MudTh>
                <div style="display:flex; align-items:center;">
                    <Label Key="Crud" />
                    <TableColumnFilterIcon Filter="filter" FilterName="Crud" />
                </div>
                <TableColumnFilterInput Filter="filter" FilterName="Crud" />
            </MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="@GetListRowClass(@context)"
                   @onclick="() => OnItemSelected.InvokeAsync(context)">
                @context.dto.Source
            </MudTd>
            <MudTd Class="@GetListRowClass(@context)"
                   @onclick="() => OnItemSelected.InvokeAsync(context)">
                @context.dto.EntityType
            </MudTd>
            <MudTd Class="@GetListRowClass(@context)"
                   @onclick="() => OnItemSelected.InvokeAsync(context)">
                @context.dto.EntityId
            </MudTd>
            <MudTd Class="@GetListRowClass(@context)"
                   @onclick="() => OnItemSelected.InvokeAsync(context)">
                @context.dto.UserName
                
            </MudTd>
            <MudTd Class="@GetListRowClass(@context)"
                   @onclick="() => OnItemSelected.InvokeAsync(context)">
                @context.dto.Updated.ToString(GC.Date_TS_Format)
            </MudTd>
            <MudTd Class="@GetListRowClass(@context)"
                   @onclick="() => OnItemSelected.InvokeAsync(context)">
                @context.dto.Crud
            </MudTd>
        </RowTemplate>
    </MudTable>

</div>
@code {
    [Parameter] public List<ListModel<AuditDto>> List { get; set; } = new List<ListModel<AuditDto>>();
    [Parameter] public EventCallback<ListModel<AuditDto>> OnItemSelected { get; set; }
        
    private FilterUtil filter = new ();
        
    protected override void OnInitialized()
    {
        filter.Changed += OnFilterChanged;
    }

    private void OnFilterChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            filter.Add("Entity", nameof(AuditDto.EntityType), FilterUtil.CompareStart)
                  .Add("Username", nameof(AuditDto.UserName))
                  .Add("Crud", nameof(AuditDto.Crud));
        }
    }

    private bool Filter(ListModel<AuditDto> item)
    {
        return filter.Filter<AuditDto>(item.dto);
    }

    public void Dispose()
    {
        filter.Changed -= OnFilterChanged;
    }

}
