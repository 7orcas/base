@inherits BasePage
@using MudBlazor
@using GC = FrontendServer.GlobalConstants;
@using FrontendServer.Base._Base;

<div style="height:100%; display:flex; flex-direction:column; min-height:0;">

    <MudTable Style="@($"flex:1; min-height:0; table-layout:fixed; width:100%; {@GetDebugBorder("blue")}")"
              T="ListModel<AuditDto>"
              @ref="_tableRef"
              Items="@List"
              Filter="FilterCode"
              Height="100%"
              FixedHeader="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              RowClassFunc="GetRowClass">


        <ColGroup>
            <col style="width:5%;" />
            <col style="width:5%;" />
            <col style="width:20%;" />
            <col style="width:5%;" />
            <col style="width:20%;" />
            <col style="width:30%;" />
            <col style="width:20%;" />
        </ColGroup>
        <HeaderContent>
            <MudTh><Label Key="OrgNr" /></MudTh>
            <MudTh><Label Key="Source" /></MudTh>
            <MudTh><Label Key="Entity" /></MudTh>
            <MudTh><Label Key="Id" /></MudTh>
            <MudTh>
                <div style="display:flex; flex-direction:column;">
                    <div style="display:flex; align-items:center;">
                        <Label Key="UserName" />
                        <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                                       Size="Size.Small"
                                       Color="@(_showCodeFilter ? Color.Primary : Color.Default)"
                                       OnClick="ToggleCodeFilter" />
                    </div>
                    @if (_showCodeFilter)
                    {
                        <MudTextField T="string"
                                      @bind-Value="_codeFilter"
                                      Immediate="true"
                                      Placeholder="@GetLabel("FilterX")"
                                      Margin="Margin.Dense"
                                      Variant="Variant.Text" />
                    }
                </div>
            </MudTh>
            <MudTh><Label Key="Created" /></MudTh>
            <MudTh><Label Key="CRUD" /></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @context.dto.OrgNr
            </MudTd>
            <MudTd>
                @context.dto.Source
            </MudTd>
            <MudTd>
                @context.dto.EntityType
            </MudTd>
            <MudTd>
                @context.dto.EntityId
            </MudTd>
            <MudTd 
                   Class="@GetListRowClass(@context)"
                   @onclick="() => OnItemSelected.InvokeAsync(context)">
                
                @context.dto.UserName
                
            </MudTd>
            <MudTd>
                @context.dto.Updated.ToString(GC.Date_TS_Format)
            </MudTd>
            <MudTd>
                @context.dto.Crud
            </MudTd>
        </RowTemplate>
    </MudTable>

</div>
@code {
    [Parameter] public List<ListModel<AuditDto>> List { get; set; } = new List<ListModel<AuditDto>>();
    [Parameter] public EventCallback<ListModel<AuditDto>> OnItemSelected { get; set; }
    [Parameter] public EventCallback<MudTable<ListModel<AuditDto>>> TableRefChanged { get; set; }


    private MudTable<ListModel<AuditDto>> _tableRef;
    private bool _showCodeFilter;
    private string _codeFilter = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await TableRefChanged.InvokeAsync(_tableRef);
    }

    private string GetCode(ListModel<AuditDto> item)
    {
        var code = item.Code;

        if (item.IsValidationError())
            code += " (" + GetLabel("Error") + ")";

        else if (item.IsValidationWarning())
            code += " (" + GetLabel("Warning") + ")";

        return code;
    }

    private string GetRowClass(ListModel<AuditDto> item, int index)
    {
        if (item.IsValidationError())
            return "error-row" + GetLightDarkClassSuffix();

        else if (item.IsValidationWarning())
            return "warning-row" + GetLightDarkClassSuffix();

        return string.Empty;
    }

    private void ToggleCodeFilter()
    {
        _showCodeFilter = !_showCodeFilter;
    }

    private bool FilterCode(ListModel<AuditDto> item)
    {
        if (string.IsNullOrWhiteSpace(_codeFilter))
            return true;

        return item.Code?.Contains(
            _codeFilter,
            StringComparison.OrdinalIgnoreCase) == true;
    }

}
