@attribute [Route(BaseRoutes.UserRoleRoute)]
@inherits BasePage
@attribute [Authorize]


<h3>All Roles</h3>

@if (loadStatus.ShowSpinner())
{
    <Loading LoadStatus=@loadStatus>
        @exception
    </Loading>

}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>RoleId</th>
                <th>Role</th>
                <th>orgNr</th>
                <th>Role Description</th>
                <th>Updated</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rec in roles)
            {
                <tr>
                    <td>@rec.RoleId</td>
                    <td>@rec.Code</td>
                    <td>@rec.OrgNr</td>
                    <td>@rec.Description</td>
                    <td>@rec.Updated</td>
                    <td>@rec.IsActive</td>
                </tr>
            }
        </tbody>
    </table>
}

@using GC = FrontendServer.GlobalConstants;
@code {
    private List<UserRoleDto>? roles;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
           // await SetClient();
            await SetConfig();

            roles = await GetAsync<List<UserRoleDto>>(GetUrl("UserRoles"));
            StateHasChanged();
        }
    }
    protected override async Task OnInitializedAsync() => loadStatus.IsLoading = true;
}