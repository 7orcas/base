@inherits BasePage
@attribute [Route(BaseRoutes.ConfigRoute)]
@attribute [PageCode(BaseRoutes.ConfigPageCode)]
@attribute [PagePermission(GC.PerConfig)]
@attribute [Authorize]

<ConfirmNavigation List="list" />

<Header @key=pageStatus.pageCode
        TitleKey="Conf"
        SubTitleKey="ConfSub"
        PageCode=@pageStatus.pageCode
        ToolBarButtonsLeft="toolBarButtonsRight" />

@if (loadStatus.ShowSpinner())
{
    <Loading LoadStatus=@loadStatus>
        @loadStatus.Exception
    </Loading>
}
else
{
    <p></p>

    <MudGrid>
       
        <!-- Right Side Details -->
        <MudItem xs="10" Style="height:100%; display:flex; flex-direction:column; min-height:0;">
            <MudPaper Elevation="0" Outlined="false" Style="flex:1; min-height:0; overflow:auto; padding-right:20px;">
                <ConfigHeaderPanel Selections="listUtil.Selections"
                                    Refresh="@Refresh"
                                    PageStatus="@pageStatus" 
                                    FieldDefinitionUtil="@fieldDefinitionUtil" />
                <ConfigLabelPanel Selections="listUtil.Selections"
                                   Refresh="@Refresh"
                                   PageStatus="@pageStatus"
                                   FieldDefinitionUtil="@fieldDefinitionUtil" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@using System.Net
@using MudBlazor
@using Newtonsoft.Json;
@using FrontendServer.Base.Util
@using FrontendServer.Base._Base;
@using GC = FrontendServer.GlobalConstants;
@inject ConfigService ConfS

@code {
    private ListModel<ConfigDto>? configDto;
    private List<ListModel<ConfigDto>> list = new List<ListModel<ConfigDto>>();
    private ListUtil<ConfigDto> listUtil = new ListUtil<ConfigDto>();
    private FieldDefinitionUtil fieldDefinitionUtil;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            loadStatus.IsLoading = true;
            var defs = await GetDefinition(GetUrl("ConfigDef"));
            fieldDefinitionUtil = new FieldDefinitionUtil(defs);

            await InitialiseBasePage();
            pageStatus.pageCode = BaseRoutes.ConfigPageCode;
            pageStatus.IsEditMode = true;

            await Load();
            loadStatus.ResetLoading();

            AddToolbarSave(SaveAsync);
            StateHasChanged();
        }
    }

    // private async void OnItemSelected(int index) => Load(index, false);

    private async Task Load() 
    {

        list.Clear();

        var dto = ConfS.Config;
        configDto = new ListModel<ConfigDto>(dto);
        configDto.ClearHash();
        configDto.HashMe();
        configDto.SetLoaded();
        list.Add(configDto);
        listUtil.Select(configDto);

        listUtil.ShowList = false;

    }

    private async Task SaveAsync()
    {
        //Get records to be updated
        var updates = new List<ListModel<ConfigDto>>();
        for (int i = 0; i < list.Count; i++)
        {
            var rec = list[i];
            rec.ResetValidation();
            if (rec.IsUpdateable())
                updates.Add(rec);
        }
        if (updates.Count == 0) return;

        loadStatus.SetSaving();

        var updatesX = new UpdateRequest<List<ConfigDto>>()
        {
            Updates = updates.Select(x => x.dto).ToList()
        };
        var response = await PostAsync<List<ConfigDto>>(GetUrl("ConfigUpdate"), updatesX);

        var r2 = null as _ResponseDto;

        if (response.StatusCode == HttpStatusCode.OK)
        {
            var r1 = await response.Content.ReadAsStringAsync();
            r2 = JsonConvert.DeserializeObject<_ResponseDto>(r1);
            configDto.ClearHash();
            configDto.HashMe();
        }
        else
        {
            loadStatus.ResetSaving();
            StateHasChanged();
            await OpenOkDialog(GetLabel("Error"), r2?.ErrorMessage);
            return;
        }

        loadStatus.ResetSaving();
        StateHasChanged();
    }

    //ToDo
    private async void Export() 
    {

    }

    private void Refresh() => StateHasChanged();
    
}