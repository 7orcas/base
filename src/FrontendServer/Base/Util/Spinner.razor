@if (_showSpinner)
{
    <div class="spinner-container">
        <div class="loading-spinner">
            <p>...</p>

        </div>
        <button class="spinner-close"
        @onclick="CancelSpinner">
            ×
        </button>
    </div>
}

@code {
    private bool _showSpinner = true;
    private bool _showCancel = false;

    protected override async Task OnInitializedAsync()
    {
        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            if (_showSpinner)
            {
                _showCancel = true;
                await InvokeAsync(StateHasChanged);
            }
        });

    }

    private void CancelSpinner()
    {
        _showSpinner = false;
        // Call whatever you need here
    }

}