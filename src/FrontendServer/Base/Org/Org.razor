@inherits BasePage
@attribute [Route(BaseRoutes.OrgRoute)]
@attribute [PageCode(BaseRoutes.OrgPageCode)]
@attribute [PagePermission(GC.PerOrg)]
@attribute //[Authorize]

<ConfirmNavigation List="list" />

<div style="height:100%; display:flex; flex-direction:column; @GetDebugBorder("yellow")">

    <HeaderThin @key=pageStatus.pageCode
                TitleKey="Org"
                PageCode=@pageStatus.pageCode
                PageStatus="@pageStatus"
                ToolBarButtonsRight="toolBarButtonsRight" />

    <div style="margin-top:10px; border-bottom: 1px solid #ccc; margin-bottom:2px;"></div>

    @if (loadStatus.IsError)
    {
        <Error LoadStatus=@loadStatus>
            @exception
        </Error>
    }
    else
    {
        <Loading LoadStatus=@loadStatus />

         <MudGrid Class="no-wrap-grid" Spacing="0" Style="@($"flex:1; min-height:0; height:0;{GetDebugBorder("orange")}")">

            @if (listUtil.ShowList)
            {
                <!-- Left Side List -->
                <MudItem xs="2" Style="height:100%; display:flex; flex-direction:column; min-height:0; max-width:300px;">
                    <MudPaper Elevation="0" Outlined="true" Style="flex:1; min-height:0; display:flex; flex-direction:column;">
                        <ListPanel TDto="OrgDto"
                                   List="@list" 
                                   OnItemSelected="@OnItemSelected" />
                    </MudPaper>
                </MudItem>
            }
            <!-- Right Side Details -->
            <MudItem xs="10" Style="height:100%; display:flex; flex-direction:column; min-height:0;">
                <MudPaper Elevation="0" Outlined="false" Style="flex:1; min-height:0; overflow:auto; padding-right:20px;">
                    <OrgHeaderPanel Selections="listUtil.Selections"
                                      Refresh="@Refresh"
                                      PageStatus="@pageStatus" 
                                      FieldDefinitionUtil="@fieldDefinitionUtil" />
                </MudPaper>
            </MudItem>

        </MudGrid>
    }
</div>


@using System.Net
@using MudBlazor
@using FrontendServer.Base.Util
@using GC = FrontendServer.GlobalConstants;
@using FrontendServer.Base._Base;
@using Newtonsoft.Json;
@inject IDialogService DialogService

@code {
    private List<ListModel<OrgDto>> list = new List<ListModel<OrgDto>>();
    private ListUtil<OrgDto> listUtil = new ListUtil<OrgDto>();
    private MudTable<ListModel<OrgDto>> _listTable;
    private FieldDefinitionUtil fieldDefinitionUtil;

    protected override async Task OnInitializedAsync()
    {
        var defs = await GetDefinition(GC.URL_org_definition);
        fieldDefinitionUtil = new FieldDefinitionUtil(defs);
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitialiseBasePage();

            //Always make edit mode
            pageStatus.IsEditMode = pageStatus.orCrudCUD();

            //Add toolbar
            if (pageStatus.isCrudU)
                AddToolbarSave(SaveAsync);

            Search();
            StateHasChanged();
        }
    }

    private async Task Search()
    {
        //There is no search form for orgs, so just load all
        await Load();
    }

    private async Task Load()
    {
        list.Clear();
        var listX = await GetAsync<List<OrgDto>>(GC.URL_org_list);

        if (listX == null)
        {
            loadStatus.SetError()
                      .ResetLoading();
            StateHasChanged();
            return;
        }

        listUtil.ShowList = true;
        foreach (var u in listX)
        {
            u.Id = GetId(u); //for the list table
            list.Add(new ListModel<OrgDto>(u));
        }

        if (list == null) { } //ToDo probably expired login
        else
        {
            if (list.Count > 0)
                Load(list[0]);
        }

    }

    private long GetId(OrgDto dto)
    {
        return dto.Nr;
    }

    private void Refresh() => StateHasChanged();

    private async Task OnItemSelected(ListModel<OrgDto> r)
    {
        await Load(r);
    }

    private async Task Load(ListModel<OrgDto> dto)
    {
        if (!dto.IsLoaded)
        {
            var record = await GetAsync<OrgDto>(GC.URL_org_get + dto.dto.Nr, false);
            record.Id = GetId(record); //for the list table
            dto.Load(record);
        }

        listUtil.Select(dto);
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        //Get records to be updated
        var updates = new List<ListModel<OrgDto>>();
        for (int i = 0; i < list.Count; i++)
        {
            var rec = list[i];
            rec.ResetValidation();
            if (rec.IsUpdateable())
                updates.Add(rec);
        }
        if (updates.Count == 0) return;

        loadStatus.SetSaving();

        var updatesX = new UpdateRequest<List<OrgDto>>()
        {
            Updates = updates.Select(x => x.dto).ToList()
        };
        var response = await PostAsync<List<OrgDto>>(GC.URL_org_update, updatesX);

        var r2 = null as _ResponseDto;

        if (response.StatusCode == HttpStatusCode.OK)
        {
            var r1 = await response.Content.ReadAsStringAsync();
            r2 = JsonConvert.DeserializeObject<_ResponseDto>(r1);
        }
        else
        {
            //ToDo error response
            return;
        }



        if (r2.Valid)
        {
            List<OrgDto> dtos = JsonConvert.DeserializeObject<List<OrgDto>>(r2.Result.ToString());

            var deletes = new List<ListModel<OrgDto>>();
            for (int i = 0; i < list.Count; i++)
            {
                var rec = list[i];
                var recU = updates.FirstOrDefault(x => x.Id == rec.Id);

                if (recU == null) continue;

                if (rec.IsDelete)
                {
                    deletes.Add(rec);
                    continue;
                }
                var dto = dtos.FirstOrDefault(x => x.Nr == rec.dto.Nr);
                if (dto == null) continue;

                rec.ClearHash();
                dto.Id = GetId(dto); //for the list table
                rec.Load(dto);
            }

            foreach (var rec in deletes)
            {
                listUtil.Remove(rec);
                list.Remove(rec);
            }

        }
        else
        {
         //   loadStatus.SetError();
            List<ValidationDto> vals = r2?.Validations;
            for (int i = 0; i < updates.Count; i++)
            {
                var rec = updates[i];
                var val = vals != null ? vals.FirstOrDefault(x => x.Id == (long)rec.dto.Nr) : null;
                if (val != null)
                {
                    rec.Validation = new ValidationModel
                    {
                        Validation = val
                    };
                }
            }
        }

        loadStatus.ResetSaving();
        StateHasChanged();
    }

    public async Task<bool> ConfirmNavigationIsOk()
    {
        for (int i = 0; list != null && i < list.Count; i++)
        {
            var dto = list[i];
            if (dto.IsLoaded && dto.HasChanged())
                return false;
        }
        return true;
    }


}