@inherits BaseComponent

@using MudBlazor
@using GC = FrontendServer.GlobalConstants;
@using FrontendServer.Base._Base;


<NumericField Width=GC.TextFieldWidth.TextVeryShort
              LangCode="LenMin"
              ReadOnly="@(!IsEditActive)"
              PageStatus=@PageStatus
              Required="@IsRequired(nameof(Dto.MinLength))"
              Value="@Dto.MinLength"
              ValueChanged="@((int val) => Dto.MinLength = val)"
              ValueExpression="() => Dto.MinLength" />

<NumericField Width=GC.TextFieldWidth.TextVeryShort
              LangCode="LenMax"
              ReadOnly="@(!IsEditActive)"
              PageStatus=@PageStatus
              Required="@IsRequired(nameof(Dto.MaxLength))"
              Value="@Dto.MaxLength"
              ValueChanged="@((int val) => Dto.MaxLength = val)"
              ValueExpression="() => Dto.MaxLength" />


@{
    var checkboxes = new[]
    {
    new CheckboxItem("PWmc", () => Dto.IsMixedCase, v => Dto.IsMixedCase = v),
    new CheckboxItem("PWNonLet", () => Dto.IsNonLetter, v => Dto.IsNonLetter = v),
    new CheckboxItem("PWNum", () => Dto.IsNumber, v => Dto.IsNumber = v),
};
}
@foreach (var checkbox in checkboxes)
{
    <CheckboxField Width="GC.TextFieldWidth.TextLong"
                   ReadOnly="@(!IsEditActive)"
                   LangCode="@checkbox.Label"
                   Value="@checkbox.GetValue()"
                   ValueChanged="@(v => checkbox.SetValue(v))" />
}


                                
@code {
    [Parameter] public PasswordRuleDto Dto { get; set; }
    [Parameter] public EventCallback Refresh { get; set; }
    
    private record CheckboxItem(
            string Label,
            Func<bool> GetValue,
            Action<bool> SetValue);


}
