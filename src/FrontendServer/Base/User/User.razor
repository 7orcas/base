@attribute [Route(BaseRoutes.UserRoute)]
@inherits BasePage
@attribute [Authorize]

<ConfirmNavigation List="list" />

<Header @key="_pageCode"
        TitleKey="UserAdm"
        PageCode=@_pageCode
        ToolBarButtonsRight="toolBarButtonsRight" />

@if (_isLoading || _isError || _isSaving)
{
    <LoadingWithError IsLoading=@_isLoading
                        IsSaving=@_isSaving
                        IsError=@_isError
                        StatusCode=@_statusCode
                        Message=@_errorMessage>
        @exception
    </LoadingWithError>
}

<MudGrid>

    <!-- Left Side: List -->
    <MudItem xs="2">
        <MudPaper Elevation="0" Outlined="true">
            <MudTable Style="table-layout: fixed;"
                    T="UserDto"
                    Items="@list"
                    Height="70vh"
                    FixedHeader="true"
                    Hover="true"
                    Bordered="true"
                    Striped="true">

                        
                <HeaderContent>
                    <MudTh colspan="2"><Label Key="UserName" /></MudTh>
                    <MudTh><Label Key="Active" /></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="max-width:0px; padding:0px; border-right: none;"
                            DataLabel="Error"
                            Class="@GetFirstColumnErrorClass(context)"
                            @onclick="() => OnItemSelected(context)">
                        @GetSelectRowPointer(context)
                    </MudTd>
                    <MudTd DataLabel="UserName"
                            Class="@GetSelectRowClass(context)"
                            @onclick="() => OnItemSelected(context)">
                        @if (isEditList || @context.IsNew())
                        {
                            <MudTextField T="string"
                                          @bind-Value="context.Username"
                                            Immediate="true"
                                            MaxLength="@GC.LenCode"
                                            Margin="Margin.Dense"
                                            Variant="Variant.Text" />
                        }
                        else
                        {
                            @context.Username
                        }
                    </MudTd>
                    <MudTd DataLabel="Active">
                        <MudCheckBox T="bool"
                                        ReadOnly="@(!_isCrudU)"
                                        @bind-Value="context.IsActive" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>

    


    <!-- Right Side: Details -->
    @if (userDto != null)
    {
        <MudItem xs="8">
            
            <MudPaper Elevation="0" Outlined="@_debugOutlined">
                <MudExpansionPanels MultiExpansion="true">
                    <MudExpansionPanel Text=@GetLabel("ConfigG") Expanded="true">
                        <TitleContent>
                            <Label Size="GC.TextSize.Normal" Key="ConfigG"></Label>
                            <div class="d-flex">
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <div style="display: flex; flex-wrap: wrap; gap: 20px;">
                                
                                <TextField Width=GC.TextFieldWidth.Medium
                                           LangCode="UserName"
                                           ReadOnly="true"
                                           MaxLength="@GC.LenCode"
                                           Value="@userDto.Username"
                                           ValueChanged="@((string val) => userDto.Username = val)"
                                           ValueExpression="() => userDto.Username" />

                                <NumericField Width=GC.TextFieldWidth.Short
                                              LangCode="OrgD"
                                              @bind-Value="@userDto.OrgNrDefault" />
                                
                                <NumericField Width=GC.TextFieldWidth.Short
                                              LangCode="LoginA"
                                              @bind-Value="@userDto.Attempts" />

                                <CheckboxField Width=GC.TextFieldWidth.Short
                                               LangCode="Active"
                                               @bind-Value="@userDto.IsActive" />

                                <Version version=@userDto />
                               
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>

                    @if (userDto?.Accounts?.Any() == true)
                    {
                        @foreach (var account in userDto.Accounts)
                        {
                            <MudExpansionPanel @key="account.Id" Text=@GetLabel("UserAc") Expanded=@Expand(account)>
                                <TitleContent>
                                    @account.OrgCode @ExpandDefault(account)
                                    <div class="d-flex">
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <MudPaper Class="pa-4 mb-4" Elevation="0">
                                        <UserAccount accountDto="@account" />
                                    </MudPaper>
                                </ChildContent>
                            </MudExpansionPanel>
                            <p></p>
                        }
                    }

                </MudExpansionPanels>
            </MudPaper>

        </MudItem>
    }
    
</MudGrid>

@using System.Net
@using MudBlazor
@using FrontendServer.Base.Util
@using System.Text;
@using sysJ = System.Text.Json
@using GC = FrontendServer.GlobalConstants;
@using FrontendServer.Base._Base;

@code {
    private List<UserDto> list;
    private UserDto? userDto;
    private bool isEditList = false;
    private List<UserDto> selections = new List<UserDto>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitialiseBasePage(GC.PerOrg);
            _pageCode = BaseRoutes.UserPageCode;

            list = await GetAsync<List<UserDto>>(GC.URL_user_list);

            if (list == null)
            {
                //probably expired login
            }
            else
            {
                if (list.Count > 0)
                    Load(list[0], true);
            }
            AddToolbarSave(SaveAsync);
            StateHasChanged();
        }
    }
    
    private string GetSelectRowPointer(UserDto dto) => GetSelectRowPointer(selections.Contains(dto));
    private string GetSelectRowClass(UserDto dto) => GetSelectRowClass(selections.Contains(dto));

    private async Task OnItemSelected(UserDto r)
    {
        await Load(r, false);
        StateHasChanged();
    }

    private async Task Load(UserDto dto, bool force)
    {
        if (!dto.IsLoaded || force){
            userDto = await GetAsync<UserDto>(GC.URL_user + dto.Id);
            userDto.HashMe();
            userDto.IsLoaded = true;
            var index = list.FindIndex(d => d.Id == userDto.Id);
            list[index] = userDto;
        }
        else
            userDto = dto;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        var curIndex = userDto != null? list.FindIndex(d => d.Id == userDto.Id) : -1;
        // var client = await SetClient();
        for (int i = 0; i < list.Count; i++) {
            var dto = list[i];
            if (dto.IsLoaded && dto.HasChanged()) {

                // var json = sysJ.JsonSerializer.Serialize(dto);
                // var content = new StringContent(json, Encoding.UTF8, "application/json");
                // var response = await client.PostAsync(GC.URL_org_update, content);

                var response = await PostAsync<UserDto>(GC.URL_user_update, dto);

                if (response.StatusCode == HttpStatusCode.OK)
                {
                    var o = await GetAsync<UserDto>(GC.URL_user + dto.Id);
                    list[i] = o.HashMe().SetLoaded();
                }
            }
        }
        _isSaving = false;

        if (userDto != null)
            OnItemSelected(userDto);
    }

    private bool Expand(UserDto.UserAccountDto account)
    {
        if (userDto == null) return false;
        return account.OrgNr == userDto.OrgNrDefault;
    }

    private string ExpandDefault(UserDto.UserAccountDto account)
    {
        if (userDto == null || userDto.Accounts == null) return "";
        if (account.OrgNr == userDto.OrgNrDefault
            && userDto.Accounts.Count > 1) 
            return "[" + GetLabel("Default") + "]";
        return "";
    }

    //ToDo
    private async void Export() 
    {

    }

    private string Label(string key) => GetLabel(key);
    protected override async Task OnInitializedAsync() => _isLoading = true;
    
}