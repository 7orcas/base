@attribute [Route(BaseRoutes.UserRoute)]
@inherits BasePage
@attribute [Authorize]


<ConfirmNavigation List="list" />

<Header @key="_pageCode"
        TitleKey="UserAdm"
        PageCode=@_pageCode
        ToolBarButtonsLeft="toolBarButtonsLeft"
        ToolBarButtonsRight="toolBarButtonsRight" />

@if (loadStatus.Show())
{
    <LoadingWithError LoadStatus=@loadStatus>
        @exception
    </LoadingWithError>
}
else
{
    <MudGrid Class="mt-4">

        @if (showList)
        {
            <!-- Left Side: List -->
            <MudItem xs="2">
                <MudPaper Elevation="0" Outlined="true">
                    <MudTable Style="table-layout:fixed; width:100%;"
                              T="BaseModel<UserDto>"
                            Items="@list"
                            Height="70vh"
                            FixedHeader="true"
                            Hover="true"
                            Bordered="true"
                            Striped="true">


                    <ColGroup>
                        <col style="width:1%;" />
                        <col style="width:69%;" />
                        <col style="width:30%;" />
                    </ColGroup>
                    <HeaderContent>
                            <MudTh></MudTh>
                            <MudTh><Label Key="UserName" /></MudTh>
                            <MudTh><Label Key="Active" /></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Style="padding:0px; border-right: none;"
                                    @key="context.Id"
                                    DataLabel="Error"
                                    Class="@GetListColumnErrorClass(context)"
                                    @onclick="() => OnItemSelected(context)">
                                @GetListSelectRowPointer(context.IsSelected)
                            </MudTd>
                            <MudTd DataLabel="UserName"
                                Class="@GetListSelectRowClass(context.IsSelected)"
                                @onclick="() => OnItemSelected(context)">
                                @if (isEditList || @context.IsNew())
                                {
                                    <MudTextField T="string"
                                                @bind-Value="context.dto.Username"
                                                Immediate="true"
                                                MaxLength="@GC.LenCode"
                                                Margin="Margin.Dense"
                                                Variant="Variant.Text" />
                                }
                                else
                                {
                                    @context.dto.Username
                                }
                            </MudTd>
                            <MudTd DataLabel="Active">
                                <MudCheckBox T="bool" ReadOnly="@(!_isCrudU)" @bind-Value="context.IsActive" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>
        }
        <!-- Right Side: Details -->
        <MudItem xs="9">
            <MudPaper Elevation="0" Outlined="true">
                <UserDetailsPanel Selections="list" TableHeight="tableHeight" />
            </MudPaper>
        </MudItem>
    
    </MudGrid>
}

@using System.Net
@using MudBlazor
@using FrontendServer.Base.Util
@using GC = FrontendServer.GlobalConstants;
@using FrontendServer.Base._Base;

@code {
    private bool showList = true;
    private List<BaseModel<UserDto>> list = new List<BaseModel<UserDto>>();
    private List<long> selections = new List<long>();
    // private Dictionary<long, BaseModel<UserDto>> loads = new Dictionary<long, BaseModel<UserDto>>();
    private bool isEditList = false;
    private int maxSelections = 2;
    private string tableHeight = "70vh";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitialiseBasePage(GC.PerUser);
            _pageCode = BaseRoutes.UserPageCode;

            var listX = await GetAsync<List<UserDto>>(GC.URL_user_list);

            if (listX == null)
            {
                loadStatus.SetError();
            }
            else
            {
                foreach (var u in listX)
                {
                    list.Add(new BaseModel<UserDto>(u));
                }
            }

            if (list == null)
            {
                //probably expired login
            }
            else
            {
                if (list.Count > 0)
                    Load(list[0]);
            }

            //testing DELETE ME
            Load(list[1]);
            Load(list[2]);

            AddToolbarSave(SaveAsync);

            toolBarButtonsLeft.Add(new ToolBarButton
            {
                LangKey = "UserA",
                Action = AddUser
            });

            StateHasChanged();
        }
    }


    private async Task OnItemSelected(BaseModel<UserDto> r)
    {
        await Load(r);
        //StateHasChanged();
    }

    private async Task Load(BaseModel<UserDto> dto)
    {
        var index = list.FindIndex(s => s.Id == dto.Id);

        if (!dto.IsLoaded)
        {
            var record = await GetAsync<UserDto>(GC.URL_user + dto.Id, true);
            dto.dto = record;
            dto.IsLoaded = true;
            dto.HashMe();
        }


        //Already selected?
        if (dto.IsSelected)
        {
            dto.IsSelected = false;
            index = selections.FindIndex(s => s == dto.Id);
            selections.RemoveAt(index);
        }
        else
        {
            if (selections.Count >= maxSelections)
            {
                var x = list.Find(s => s.Id == selections[0]);
                x.IsSelected = false;
                selections.RemoveAt(0);
            }


            dto.IsSelected = true;
            selections.Add(dto.Id);
        }

        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        loadStatus.SetSaving();

        for (int i = 0; i < list.Count; i++)
        {
            var dto = list[i];
            if (dto.IsLoaded && dto.HasChanged())
            {

                var response = await PostAsync<UserDto>(GC.URL_user_update, dto.dto);

                if (response.StatusCode == HttpStatusCode.OK)
                {
                    var updatedDto = await GetAsync<UserDto>(GC.URL_user + dto.Id);
                    dto.dto = updatedDto;
                    dto.ClearHash()
                       .HashMe()
                       .SetLoaded();
                }
            }
        }
        loadStatus.ResetSaving();
        StateHasChanged();
    }

    private async Task AddUser()
    {

    }

    //ToDo
    private async void Export()
    {

    }

    protected override async Task OnInitializedAsync() => loadStatus.SetLoading();

}