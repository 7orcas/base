@inherits BasePage
@attribute [Route(BaseRoutes.UserRoute)]
@attribute [Authorize]

<ConfirmNavigation List="list" />


<div style="height:100%; display:flex; flex-direction:column; @GetDebugBorder("yellow")">

    <HeaderThin @key="_pageCode"
            TitleKey="UserAdm"
            PageCode=@_pageCode
            ToolBarButtonsLeft="toolBarButtonsLeft"
            ToolBarButtonsRight="toolBarButtonsRight" />
    

    @if (loadStatus.Show())
    {
        <LoadingWithError LoadStatus=@loadStatus>
            @exception
        </LoadingWithError>
    }
    else
    {
        <MudGrid Spacing="0" Style="@($"flex:1; min-height:0; height:0;{GetDebugBorder("orange")}")">

            @if (listUtil.ShowList)
            {
                <!-- Left Side List -->
                <MudItem xs="2" Style="height:100%; display:flex; flex-direction:column; min-height:0; max-width:300px;">
                    <MudPaper Elevation="0" Outlined="true" Style="flex:1; min-height:0; display:flex; flex-direction:column;">
                        <ListPanel TDto="UserDto"
                                   List="@list" 
                                   CodeKey="UserName"
                                   OnItemSelected="@OnItemSelected" />
                    </MudPaper>
                </MudItem>
            }
            <!-- Right Side Details -->
            <MudItem xs="10" Style="height:100%; display:flex; flex-direction:column; min-height:0;">
                <MudPaper Elevation="0" Outlined="false" Style="flex:1; min-height:0; overflow:auto; padding-right:20px;">
                    <UserDetailsPanel Selections="list" FormStatus=@formStatus />
                </MudPaper>
            </MudItem>
    
        </MudGrid>
    }
</div>

@using System.Net
@using MudBlazor
@using FrontendServer.Base.Util
@using GC = FrontendServer.GlobalConstants;
@using FrontendServer.Base._Base;
@using Newtonsoft.Json;
@inject IDialogService DialogService

@code {
    private List<ListModel<UserDto>> list = new List<ListModel<UserDto>>();
    private ListUtil<UserDto> listUtil = new ListUtil<UserDto>();
    private FormStatus formStatus = new FormStatus();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitialiseBasePage(GC.PerUser);
            _pageCode = BaseRoutes.UserPageCode;

            //  await Load();

            AddToolbarSave(SaveAsync);

            formStatus.LS = GetLabelService();
            if (_isCrudU)
                toolBarButtonsLeft.Add(new ToolBarButton
                {
                    GetLabel = formStatus.GetEditModeLabel,
                    Action = EditRecord

                });

            if (_isCrudC)
                toolBarButtonsLeft.Add(new ToolBarButton
                {
                    LangKey = "UserA",
                    Action = AddRecord
                });


            toolBarButtonsLeft.Add(new ToolBarButton
{
    LangKey = "Search",
    Action = Search
});
            Search();
            StateHasChanged();
        }
    }

    private async Task Search()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = false,
            BackdropClick = false
        };


        var dialog = await DialogService.ShowAsync<UserSearchDialog>("", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var data = (UserSearch)result.Data;

            // var search = new UserSearch
            // {
            //     Username = data.Username,
            //     Email = data.Email
            // };

            await Load(data);
        }
        
    }




    private async Task Load(UserSearch search)
    {
        var response = await PostAsync<_ResponseDto, UserSearch>(GC.URL_user_list, search);

        list.Clear();
        List<UserDto> listX = null;

        if (response.StatusCode == HttpStatusCode.OK)
        {
            var r = await response.Content.ReadAsStringAsync();
            var dto = JsonConvert.DeserializeObject<_ResponseDto>(r);

            if (dto.Valid)
                listX = JsonConvert.DeserializeObject<List<UserDto>>(dto.Result.ToString());

        }


        if (listX == null)
            loadStatus.SetError();
        else
        {
            listUtil.ShowList = true;
            foreach (var u in listX)
            {
                u.Code = u.Username; //for the list table
                list.Add(new ListModel<UserDto>(u));
            }
        }

        if (list == null) { } //ToDo probably expired login
        else
        {
            if (list.Count > 0)
                Load(list[0]);
        }

        //testing DELETE ME
        //listUtil.MaxSelections = 20;
if (list.Count > 1) Load(list[1]);
if (list.Count > 2) Load(list[2]);


       // await Search();
    }



    private async Task OnItemSelected(ListModel<UserDto> r)
    {
        await Load(r);
    }

    private async Task Load(ListModel<UserDto> dto)
    {
        if (!dto.IsLoaded)
        {
            var record = await GetAsync<UserDto>(GC.URL_user + dto.Id, true);
            record.Code = record.Username; //for the list table
            dto.Load(record);
        }

        listUtil.Select(dto);
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        loadStatus.SetSaving();

        for (int i = 0; i < list.Count; i++)
        {
            var dto = list[i];
            if (dto.IsLoaded && dto.HasChanged())
            {

                var response = await PostAsync<UserDto>(GC.URL_user_update, dto.dto);

                if (response.StatusCode == HttpStatusCode.OK)
                {
                    var updatedDto = await GetAsync<UserDto>(GC.URL_user + dto.Id);
                    dto.ClearHash();
                    updatedDto.Code = updatedDto.Username; //for the list table
                    dto.Load(updatedDto);
                }
            }
        }
        loadStatus.ResetSaving();
        StateHasChanged();
    }

    private async Task EditRecord()
    {
        if (!_isCrudU) return;
        formStatus.ToggleEdit();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task AddRecord()
    {

    }

    //ToDo
    private async void Export()
    {

    }

    //protected override async Task OnInitializedAsync() => loadStatus.SetLoading();

}