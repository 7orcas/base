@inherits BaseComponent

@using MudBlazor
@using GC = FrontendServer.GlobalConstants;
@using FrontendServer.Base._Base;

<div style="height:100%; overflow:auto;">

    <table style="flex:1; min-height:0; table-layout:fixed; width:100%;@GetDebugBorder("pink")">

        <tbody class="mud-table-body">
            <tr class="XXmud-table-row">
                @foreach (var record in Selections.Where(x => x.IsSelected))
                {
                var dto = record.dto;

                <td @key="record.Id" style="vertical-align: top; padding: 1px; background-color:white">

                    <MudExpansionPanels MultiExpansion="true">

                        @if (record.IsValidation())
                        {
                            <MudExpansionPanel @key="record" Text=@GetValidationLabel(record) Expanded=true Style="padding:1px;" Class="@GetValidationClass(record)">
                                <ChildContent>
                                    <ErrorPanel List="record.Validation.Messages" />
                                </ChildContent>
                            </MudExpansionPanel>
                        }

                        <MudExpansionPanel Text=@GetLabel("ConfigG") Expanded="true">
                            <TitleContent>
                                <div class="expansion-title">
                                    <div style="display:flex; justify-content:space-between; align-items:center;">
                                        <Label Size="GC.TextSize.Normal" Key="ConfigG"></Label>
                                        <CheckboxField Width=GC.TextFieldWidth.TextShort
                                                        Class="delete-checkbox"
                                                        LangCode="Delete"
                                                        ReadOnly="!IsDeleteActive"
                                                        @bind-Value="dto.IsDelete"
                                                        @bind-Value:after="OnDeleteChanged" />
                                    </div>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <div style="display: flex; flex-wrap: wrap; gap: 10px;">

                                    <div style="display:flex; align-items:flex-end; gap:5px;">
                                        <TextField Width=GC.TextFieldWidth.TextMedium
                                                    LangCode="UserName"
                                                    ReadOnly="!dto.IsNew()"
                                                    PageStatus=@PageStatus
                                                    MaxLength="@GetMaxLength(nameof(dto.Username))"
                                                    Required="@IsRequired(nameof(dto.Username))"
                                                    Immediate="true"
                                                    Value="@dto.Username"
                                                    ValueChanged="@(v => UsernameChanged(v, record))" />

                                        <CheckboxField Width=GC.TextFieldWidth.TextShort
                                                LangCode="Active"
                                                @bind-Value="dto.IsActive" />
                                    </div>

                                    <div class="password-field-container">
                                        <TextField Width=GC.TextFieldWidth.TextMedium
                                                    LangCode="PWn"
                                                    PageStatus=@PageStatus
                                                    MaxLength="@GetMaxLength(nameof(dto.PasswordNew))"
                                                    Required="@IsRquiredNew(nameof(dto.PasswordNew),dto.IsNew())"
                                                    InputType="@(showPassword ? InputType.Text : InputType.Password)"
                                                    @bind-Value="dto.PasswordNew" />

                                        <button type="button"
                                                class="password-toggle-btn"
                                                @onclick="TogglePassword">
                                            <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                        </button>
                                    </div>

                                    <div style="display:flex; align-items:flex-end; gap:5px;">
                                        <TextField Width=GC.TextFieldWidth.TextMedium
                                                    LangCode="Email"
                                                    PageStatus=@PageStatus
                                                    MaxLength="@GetMaxLength(nameof(dto.Email))"
                                                    Required="@IsRequired(nameof(dto.Email))"
                                                    @bind-Value="dto.Email" />

                                        <CheckboxField Width=GC.TextFieldWidth.TextShort
                                                       LangCode="EmailVZ"
                                                       @bind-Value="dto.IsEmailVerified" />
                                    </div>

                                    <TextField Width=GC.TextFieldWidth.TextVeryShort
                                                LangCode="LangCode"
                                                PageStatus=@PageStatus
                                                MaxLength="@GetMaxLength(nameof(dto.LangCode))"
                                                Required="@IsRequired(nameof(dto.LangCode))"
                                                @bind-Value="dto.LangCode" />

                                    <NumericField LangCode="OrgD"
                                                PageStatus=@PageStatus
                                                @bind-Value="dto.OrgNr" />

                                    <div style="display:flex; align-items:flex-end; gap:5px;">
                                        <NumericField LangCode="LoginA"
                                                    PageStatus=@PageStatus
                                                    @bind-Value="dto.Attempts" />
                                        <div class="@GetAttemptsClass()">
                                            @dto.AttemptsMessage
                                        </div>
                                    </div>

                                    <CheckboxField LangCode="AdminU"
                                                PageStatus=@PageStatus
                                                @bind-Value="@dto.IsAdminUser" />

                                    <Version version=dto />

                                </div>
                            </ChildContent>
                        </MudExpansionPanel>
                        @if (dto.Accounts?.Any() == true)
                        {
                            @foreach (var account in dto.Accounts)
                            {
                                <MudExpansionPanel @key="account.Id" Text=@GetLabel("UserAc") Expanded=@Expand(account, dto) Style="padding:1px;">
                                    <TitleContent>
                                        <div class="expansion-title">
                                            @GetLabel("UserAc") : @account.OrgCode @ExpandDefault(account, dto)
                                        </div>
                                    </TitleContent>
                                    <ChildContent>
                                        <MudPaper Class="pa-4 mb-4" Elevation="0">
                                            <UserAccount accountDto="account"
                                                         PageStatus="@PageStatus" />
                                        </MudPaper>
                                    </ChildContent>
                                </MudExpansionPanel>
                            }
                        }

                    </MudExpansionPanels>
                </td>
            }
            </tr>
        </tbody>

    </table>
</div>

@code {
    [Parameter] public List<ListModel<UserDto>> Selections { get; set; } = new List<ListModel<UserDto>>();
    [Parameter] public EventCallback Refresh { get; set; }
    
    private bool showPassword = false;

    private bool Expand(UserDto.UserAccountDto account, UserDto user)
    {
        return account.OrgNr == user.OrgNr;
    }

    private string ExpandDefault(UserDto.UserAccountDto account, UserDto user)
    {
        if (account.OrgNr == user.OrgNr
            && user.Accounts.Count > 1)
            return "[" + GetLabel("Default") + "]";
        return "";
    }

    // private void OnDeleteChanged()
    // {
    //     StateHasChanged();
    // }

    private async Task UsernameChanged(string value, ListModel<UserDto> record)
    {
        record.dto.Username = value;
        record.dto.Code = value;
        await Refresh.InvokeAsync();
    }

    // private string GetValidationLabel(ListModel<UserDto> record)
    // {
    //     if (record.Validation.MessageCount > 1)
    //         return GetLabel("ValMs");
    //     return GetLabel("ValM");
    // }

    // private string GetValidationClass(ListModel<UserDto> record)
    // {
    //     if (record.IsValidationError())
    //         return "error-row" + DarkModeSuffix();

    //     if (record.IsValidationWarning())
    //         return "warning-row" + DarkModeSuffix();

    //     return string.Empty;
    // }

    private string GetAttemptsClass() => "error-row" + DarkModeSuffix();
   // private bool IsDeleteActive => PageStatus == null ? false : PageStatus.isCrudD;
    private void TogglePassword() => showPassword = !showPassword;
    
}
