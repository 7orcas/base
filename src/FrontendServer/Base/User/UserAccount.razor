@inherits BaseComponent

@using System.Linq.Expressions
@using MudBlazor
@using GC = FrontendServer.GlobalConstants;

<div style="display:flex; flex-wrap:wrap; gap:20px;">

    <div class="accout-details" style="flex:0 0 100%; display:flex; flex-wrap:wrap; gap:20px; align-items:center;">
        <NumericField LangCode="OrgNr"
                      ReadOnly="true"
                      @bind-Value="@accountDto.OrgNr" />

        <NumericField LangCode="Clas"
                      FormStatus=@FormStatus
                      @bind-Value="@accountDto.Classification" />

        <CheckboxField LangCode="Active"
                       FormStatus=@FormStatus
                       @bind-Value="@accountDto.IsActive" />

        <CheckboxField LangCode="AdminL"
                       FormStatus=@FormStatus
                       @bind-Value="@accountDto.IsAdminLang" />
    </div>

    <div class="accout-roles" style="flex:1;">
        <div class="useracc-table-title">
            <MudText>
                @GetLabel("Roles") :
            </MudText>
        </div>
        <MudTable Style="@($"flex:1; min-height:0; table-layout:fixed; width:100%; {@GetDebugBorder("blue")}")"
                  T="UserDto.UserAccountRoleDto"
                  Items="@accountDto.Roles"
                  Height="100%"
                  FixedHeader="true"
                  Hover="true"
                  Bordered="true"
                  Striped="true">


            <ColGroup>
                <col style="width:40%;" />
                <col style="width:25%;" />
                <col style="width:35%;" />
            </ColGroup>
            <HeaderContent>
                <MudTh><Label Key="Role" /></MudTh>
                <MudTh><Label Key="Active" /></MudTh>
                <MudTh><Label Key="Assigned" /></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @context.Code
                </MudTd>
                <MudTd>
                    <MudCheckBox T="bool" ReadOnly="true" @bind-Value="context.IsRoleActive" />
                </MudTd>
                <MudTd>
                    <MudCheckBox T="bool" ReadOnly="@(!IsEditActive)" @bind-Value="context.IsActive" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>

    <div class="accout-permissions" style="flex:1;">
        <div class="useracc-table-title">
            <MudText>
                @GetLabel("PermEff") :
            </MudText>
        </div>
        <MudTable Style="@($"flex:1; min-height:0; table-layout:fixed; width:100%; {@GetDebugBorder("blue")}")"
                  T="UserDto.UserAccountPermissionDto"
                  Items="@accountDto.Permissions"
                  Height="100%"
                  FixedHeader="true"
                  Hover="true"
                  Bordered="true"
                  Striped="true">


            <ColGroup>
                <col style="width:60%;" />
                <col style="width:40%;" />
            </ColGroup>
            <HeaderContent>
                <MudTh><Label Key="Perm" /></MudTh>
                <MudTh><Label Key="Crud" /></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @context.Code
                </MudTd>
                <MudTd>
                    @context.Crud
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>
</div>

@code {
    [Parameter] public UserDto.UserAccountDto accountDto { get; set; }
    [Parameter] public FormStatus? FormStatus { get; set; }
    
    public bool IsEditActive => FormStatus == null ? false : FormStatus.IsEditMode;
}
