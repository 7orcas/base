@inherits BasePage
 
<BaseSearchDialog Width="800px"
                  Height="400px"
                  TitleKey="UserSr"
                  SubmitAction="Submit"
                  IsValid="data.IsValid()"
                  BaseSearch="data"
                  MaxRecordsReturned="MaxRecordsReturned"
                  IsService="IsService">

    <TextField Width=GC.TextFieldWidth.TextMedium
                LangCode="UserName"
                MaxLength="@GC.LenCode"
                Immediate="true"
                @ref="usernameField"
                @bind-Value="data.Username" />

    <TextField Width=GC.TextFieldWidth.TextMedium
               LangCode="Email"
               MaxLength="@GC.LenEmail"
               @bind-Value="data.Email" />

    <div class="d-flex align-center">
        <TextField Width=GC.TextFieldWidth.TextMedium
                   LangCode="Role"
                   MaxLength="@GC.LenCode"
                   @bind-Value="data.Role" />

        <CheckboxField Width=GC.TextFieldWidth.TextMedium
                       LangCode="EffID"
                       @bind-Value="data.IncludeEffectDate" />
    </div>

    <TextField Width=GC.TextFieldWidth.TextMedium
               LangCode="Perm"
               MaxLength="@GC.LenCode"
               @bind-Value="data.Permission" />

</BaseSearchDialog>


@using GC = FrontendServer.GlobalConstants;

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public int MaxRecordsReturned { get; set; }
    [Parameter] public bool IsService { get; set; }

    private UserSearch data = new UserSearch ();
    private TextField usernameField;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            data = await GetAsync<UserSearch>(GC.URL_user_search, false);
            data.MaxRecordsReturned = MaxRecordsReturned;

            await InvokeAsync(async () =>
            {
                await Task.Yield();
                await Task.Delay(100);
                await usernameField!.FocusAsync();
                StateHasChanged();
            });
        }
    }

    private async Task Submit()
    {
        if (data.IsValid())
        {
            MudDialog.Close(DialogResult.Ok(data));
        }
    }

}
