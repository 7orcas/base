
<div class="vertical-menu">
    @for (int i = 0; i < mainMenuItems.Count(); i += cMax)
    {
        <MenuButton Title="@mainMenuItems[i + cLabel]" Link="@mainMenuItems[i + cRoute]" />
    }
    @if (mainMenuItems.Count() == 0)
    {
        <div>Press F5</div>
    }

    @if (isAdminMenu)
    {
        <div style="width:100%;">
            <MudButton Class="custom-menu-button"
                       Variant="Variant.Text"
                       Color="Color.Inherit"
                       OnClick="ToggleAdminMenu">

                <MudText Typo="Typo.h6">@GetLabel("AdminM")</MudText>
                <MudIcon Icon="@(showAdmin ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Class="mr-2" />
            </MudButton>

            @if (showAdmin)
            {
                <MudStack Spacing="0" Class="custom-menu-sub">
                    @for (int j = 0; j < adminMenuItems.Count(); j += cMax)
                    {
                        <MenuButton Title="@adminMenuItems[j + cLabel]" Link="@adminMenuItems[j + cRoute]" />
                    }
                </MudStack>
            }
        </div>
    }
</div>

@inject ConfigService ConfS
@inject MenuService MenuS
@inject LabelService LS
@inject ThemeService TS
@code {
    private int cCode  = 0;
    private int cRoute = 1;
    private int cLabel = 2;
    private int cMax   = 3;

    private const int KeyIndex = 0;
    private const int LabelIndex = 1;
    private const int RouteIndex = 2;
    private const int MaxFields = 3;

    private string[] MainMenuItems = { //menu key, LangKey, route
            "Machine",    "Machines",  AppRoutes.MachinesRoute,
            "Trail",      "Trails",    AppRoutes.TrailRoute,
            "TrailGroup", "TrailsGrp", AppRoutes.TrailGroupRoute,
            "Audit",      "Audit",     AppRoutes.AuditRoute,
            //INSERT_GENERATED_CODE_HERE

            //"CodeTemplate", "CodeTemplates", AppRoutes.CodeTemplateRoute, //Testing foe code generation
    };

    private string[] AdminMenuItems = { //menu key, LangKey, route
            "Org",        "Organisation", AppRoutes.OrgRoute,
            "Perm",       "Permissions",  AppRoutes.PermRoute,
            "Role",       "Roles",        AppRoutes.RoleRoute,
            "User",       "User",         AppRoutes.UserRoute,
            "User",       "UserRs",       AppRoutes.UserRoleRoute,
            "LabelAdmin", "LabelA",       AppRoutes.LabelAdminRoute,
    };


    private bool isAdminMenu = false;
    private bool showAdmin = false;

    private List<string> mainMenuItems = new List<string>();
    private List<string> adminMenuItems = new List<string>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!MenuS.IsInitialized)
                await MenuS.InitializeFromCache();


            for (int i = 0; i < MainMenuItems.Length; i += MaxFields)
            {
                if (MenuS.IsMenu(MainMenuItems[i + KeyIndex]))
                {
                    mainMenuItems.Add(MainMenuItems[i + LabelIndex]);
                    mainMenuItems.Add(MainMenuItems[i + RouteIndex]);
                    mainMenuItems.Add(LS.GetLabel(MainMenuItems[i + LabelIndex]));
                }
            }

            for (int i = 0; i < AdminMenuItems.Length; i += MaxFields)
            {
                if (MenuS.IsMenu(AdminMenuItems[i + KeyIndex]))
                {
                    adminMenuItems.Add(AdminMenuItems[i + LabelIndex]);
                    adminMenuItems.Add(AdminMenuItems[i + RouteIndex]);
                    adminMenuItems.Add(LS.GetLabel(AdminMenuItems[i + LabelIndex]));
                }
            }
                    
            isAdminMenu = adminMenuItems.Count > 0;
            RefreshLayout();
            LS.OnLabelsChanged += RefreshLayout;
        }
    }

    private void RefreshLayout()
    {
        SetLabels(mainMenuItems);
        SetLabels(adminMenuItems);
        InvokeAsync(StateHasChanged);
    }

    private void SetLabels(List<string> menu)
    {
        for (int i = 0; i < menu.Count(); i += cMax)
            menu[i + cLabel] = LS.GetLabel(menu[i + cCode]);
    }

    private string GetLabel(string key) => LS.GetLabel(key);

    public void Dispose() => LS.OnLabelsChanged -= RefreshLayout;

    private void ToggleAdminMenu() => showAdmin = !showAdmin;
    
    public string GetLightDarkClassSuffix() => TS.IsDarkMode ? "-dark" : "-light";
        

}
