
<div class="vertical-menu">
    @for (int i = 0; i < mainMenuItems.Count(); i += cMax)
    {
        <MenuButton Title="@mainMenuItems[i + cLabel]" Link="@mainMenuItems[i + cRoute]" />
    }

    @if (isAdminMenu)
    {
        <div style="width:100%;">
            <MudButton Class="custom-menu-button"
                       Variant="Variant.Text"
                       Color="Color.Inherit"
                       OnClick="ToggleAdminMenu">

                <MudText Typo="Typo.h6">@GetLabel("AdminM")</MudText>
                <MudIcon Icon="@(showAdmin ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Class="mr-2" />
            </MudButton>

            @if (showAdmin)
            {
                <MudStack Spacing="0" Class="custom-menu-sub">
                    @for (int j = 0; j < adminMenuItems.Count(); j += cMax)
                    {
                        <MenuButton Title="@adminMenuItems[j + cLabel]" Link="@adminMenuItems[j + cRoute]" />
                    }
                </MudStack>
            }
        </div>
    }
</div>

@inject ConfigService ConfS
@inject MenuService MenuS
@inject LabelService LS
@inject ThemeService TS
@code {
    private int cCode  = 0;
    private int cRoute = 1;
    private int cLabel = 2;
    private int cMax   = 3;

    private bool isAdminMenu = false;
    private bool showAdmin = false;

    private List<string> mainMenuItems = new List<string>();
    private List<string> adminMenuItems = new List<string>();

    protected override void OnInitialized()
    {

        if (MenuS.IsMenu("Machine")) AddItem(mainMenuItems, "Machines", AppRoutes.MachinesRoute, "");
        if (MenuS.IsMenu("Audit")) AddItem(mainMenuItems, "Audit", AppRoutes.AuditRoute, "");
        if (MenuS.IsMenu("Org")) AddItem(mainMenuItems, "Organisation", AppRoutes.OrgRoute, "");
        SetLabels(mainMenuItems);


        if (MenuS.IsMenu("Perm")) AddItem(adminMenuItems, "Permissions", AppRoutes.PermRoute, "");
        if (MenuS.IsMenu("Role")) AddItem(adminMenuItems, "Roles", AppRoutes.RoleRoute, "");
        if (MenuS.IsMenu("User")) AddItem(adminMenuItems, "User", AppRoutes.UserRoute, "");
        if (MenuS.IsMenu("User")) AddItem(adminMenuItems, "UserRs", AppRoutes.UserRoleRoute, "");
        if (MenuS.IsMenu("Config")) AddItem(adminMenuItems, "Config", AppRoutes.ConfigRoute, "");
        SetLabels(adminMenuItems);
        isAdminMenu = adminMenuItems.Count > 0;

        LS.OnLabelsChanged += RefreshLayout;
    }

    private void RefreshLayout()
    {
        SetLabels(mainMenuItems);
        SetLabels(adminMenuItems);
        InvokeAsync(StateHasChanged);
    }

    private void SetLabels(List<string> menu)
    {
        for (int i = 0; i < menu.Count(); i += 3)
            menu[i + cLabel] = LS.GetLabel(menu[i + cCode]);
    }

    private string GetLabel(string key) => LS.GetLabel(key);

    public void Dispose() => LS.OnLabelsChanged -= RefreshLayout;

    private void ToggleAdminMenu() => showAdmin = !showAdmin;
    
    public string GetLightDarkClassSuffix() => TS.IsDarkMode ? "-dark" : "-light";

    private void AddItem(List<string> menu, string code, string route, string label)
    {
        menu.Add(code);
        menu.Add(route);
        menu.Add(label);
    }

}
