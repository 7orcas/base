@inherits LayoutComponentBase

<div class="layout-root">
    
    <MudThemeProvider DefaultScrollbar="true" @bind-IsDarkMode="_isDarkMode" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    @if (!ConfS.IsInitialized)
    {
        <Loading />
        @Body
    }
    else
    {
        <MudLayout Style="@($"height:100vh; display: flex; flex-direction: column; {GetDebugBorder("black")}")">

            <MudPaper Style=@($"width:100%; left:0; right:0;{GetDebugBorder("grey")}")"
                       Class="@($"main-title{GetLightDarkClassSuffix()}")"                       
                       Elevation="0">
                
                <div style="display: flex; align-items: center; width: 100%; justify-content: space-between;">

                    <div style="display: flex; align-items: center;">
                        <MudButton Href="@AppRoutes.HomeRoute">
                            <img src=@ConfS.Config.Org.Icon
                                    alt="Icon"
                                    style="width:48px;height:48px;" />
                        </MudButton>
                        <div style="color:red;background-color:white;">
                            @ShowDebugMode()
                        </div>
                    </div>

                    <!-- Center: Menu items -->
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        @ConfS.Config.Org.Description
                    </MudText>

                    <!-- Right Settings -->
                    <div style="display: flex; align-items: center; gap: 12px;">
                        
                        <MudIconButton Style="font-size:32px;color:white;"
                            Icon="@Icons.Material.Filled.Chat"
                            OnClick="ToggleChat" />

                        <MudMenu ActivationEvent="MouseEvent.MouseOver"
                                 AnchorOrigin="Origin.BottomLeft"
                                 TransformOrigin="Origin.TopLeft"
                                 OffsetY="true"
                                 Dense="true">
                            <ActivatorContent>
                                <MudIconButton Icon="@Icons.Material.Filled.ManageAccounts"
                                               Color="Color.Inherit"
                                               Size="Size.Large"/>
                            </ActivatorContent>
                            <ChildContent>
                                <MudStack Spacing="1" Style="align-items: flex-start;">
                                    <MudButton Class="custom-menu-button"
                                               Link="true"
                                               OnClick="@Logout"
                                               Color="Color.Inherit"
                                               Variant="Variant.Text">
                                        <MudText Typo="Typo.h6">@GetLabel("Logout")</MudText>
                                    </MudButton>
                                    
                                    <MudButton OnClick="OpenChat">
                                        <MudText Typo="Typo.h6">@GetLabel("Chat")</MudText>
                                    </MudButton>

                                    <div style="margin-left:9px;">
                                        <MudSwitch @bind-Value="_isDarkMode"
                                                   T="bool"
                                                   LabelPlacement="Placement.Start"
                                                    >
                                            <MudText Typo="Typo.h6">@GetLabel("LDM")</MudText>
                                        </MudSwitch>
                                    </div>
                                    <MenuButton Title="@GetLabel("ChgPw")" Link="@AppRoutes.ChangePWRoute" />
                                    <MenuButton Title="@GetLabel("Config")" Link="@AppRoutes.ConfigRoute" />
                                    
                                    <MudButton OnClick="ResetLabels" >
                                        <MudText Typo="Typo.h6">*Reset Labels*</MudText>
                                    </MudButton>
                                </MudStack>
                            </ChildContent>
                        </MudMenu>
                    </div>

                </div>
            </MudPaper>

            <MudMainContent Class="main-content main-content-fill-screen" 
                            Style=@($"flex: 1 1 auto; min-height: 0 !important; overflow: hidden; height:100%; {GetDebugBorder("pink")}")">

                <div style="display:flex; height: 100%">

                    <div id="leftPanel" 
                        class="left-panel @($"main-menu{GetLightDarkClassSuffix()}")" 
                         style="width:@($"{_leftPanelWidth}px"); @($"{GetDebugBorder("brown")}")">
                        <MainMenu />
                    </div>

                    <div id="leftSplitter" class="splitter"></div>

                    <div class="main-panel" 
                         style="height: 100%;@GetDebugBorder("brown")">
                        @Body
                    </div>

                    @if (_chatOpen)
                    {
                        <div id="rightSplitter" class="splitter"></div>
                        <div id="rightPanel" class="right-panel" style="width:@($"{_rightPanelWidth}px");">
                            <ServiceMenu />
                        </div>
                    }

                </div>
                
            </MudMainContent>


            <MudPaper Style="height: 40px; flex-shrink: 0;"
                      Class="bottom-bar d-flex justify-space-between align-center" 
                      Elevation="0" 
                      Square="true">
                <div style="display: flex; align-items: center;">
                    111
                </div>
                <div style="display: flex; gap: 16px;">
                    2222222222222222222222222222222222222222222222222222222222
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                    333x
                </div>
            </MudPaper>

        </MudLayout>
    }
</div>

@using GC = FrontendServer.GlobalConstants;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject ConfigService ConfS
@inject LabelService LS
@inject ThemeService TS
@inject LogoutService LgS
@inject ProtectedSessionStorage PS
@code {

    [Inject] IJSRuntime JS { get; set; } = default!;
    private DotNetObjectReference<MainLayout>? _objRef;
    private bool _chatOpen = false;
    private bool _isDarkModeBacking = false;
    private int _leftPanelWidth = 150;
    private int _rightPanelWidth = 400;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ConfS.IsInitialized)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initSplitters", _objRef);
        }
    }

    protected override void OnInitialized()
    {
        LS.OnLabelsChanged += RefreshLayout;
        TS.SetDarkMode(_isDarkMode);

        if (!ConfS.IsInitialized)
        {
            ConfS.OnInitialized += HandleConfigInitialized;
        }
    }

    private void HandleConfigInitialized() => InvokeAsync(StateHasChanged);

    private bool _isDarkMode
    {
        get => _isDarkModeBacking;
        set
        {
            _isDarkModeBacking = value;
            TS.SetDarkMode(value);
            StateHasChanged();
        }
    }

    public string GetLightDarkClassSuffix() => TS.IsDarkMode ? "-dark" : "-light";

    private string ShowDebugMode()
    {
        if (@ConfS.IsDebugMode)
            return "Debug mode is on ";
        return "";
    }

    private void RefreshLayout() 
    {
        InvokeAsync(StateHasChanged);
    }

    private void ResetLabels()
    {
        LS.Reset();
    }

    private void OpenChat()
    {
        _chatOpen = !_chatOpen;
    }

    private string GetLabel(string key)
    {
        return LS.GetLabel(key);
    }

    private void ToggleChat() => _chatOpen = !_chatOpen;
    private async Task Logout() => await LgS.LogoutAsync();
    
    public void Dispose() 
    {
        LS.OnLabelsChanged -= RefreshLayout;
        ConfS.OnInitialized -= HandleConfigInitialized;
    }

    [JSInvokable]
    public async Task PanelResized(string panel, int width)
    {
        //ToDo FixMe: Implement logic to save the new width of the panels
        if (panel == "LeftPanel")
            _leftPanelWidth = width;

        if (panel == "RightPanel")
            _rightPanelWidth = width;


        // Save to session storage
        // Save to database
        // Update user preferences
    }

    public async ValueTask DisposeAsync()
    {
        _objRef?.Dispose();
    }

    public string GetDebugBorder(string color)
    {
        if (ConfS == null) return string.Empty;
        return ConfS.IsDebugBorder ? " border:5px solid " + color + ";" : string.Empty;
    }

}