@inherits LayoutComponentBase

<div class="layout-root">

    <MudThemeProvider DefaultScrollbar="true" @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    @if (!ConfS.IsInitialized)
    {
        <Loading />
        @Body
    }
    else
    {
        <MudLayout>

            <MudAppBar Elevation="1" Style="background-color: #1565C0;width:100%; left:0; right:0;">
                <MudText style="display: flex; align-items: center; width: 100%; justify-content: space-between;">

                    <div style="display: flex; align-items: center;">
                        <MudButton Href="@AppRoutes.HomeRoute">
                            <img src=@ConfS.Config.Org.Icon
                                    alt="Icon"
                                    style="width:48px;height:48px;" />
                        </MudButton>
                    </div>

                    <!-- Center: Menu items -->
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        @ConfS.Config.Org.Description
                    </MudText>

                    <!-- Right Settings -->
                    <div style="display: flex; align-items: center; gap: 12px;">
                        
                        <MudIconButton Style="font-size:32px;color:white;"
                            Icon="@Icons.Material.Filled.Chat"
                            OnClick="ToggleChat" />

                        <MudMenu ActivationEvent="MouseEvent.MouseOver"
                                 AnchorOrigin="Origin.BottomLeft"
                                 TransformOrigin="Origin.TopLeft"
                                 OffsetY="true"
                                 Dense="true">
                            <ActivatorContent>
                                <MudIconButton Icon="@Icons.Material.Filled.ManageAccounts"
                                               Color="Color.Inherit"
                                               Size="Size.Large"/>
                            </ActivatorContent>
                            <ChildContent>
                                <MudStack Spacing="1" Style="align-items: flex-start;">
                                    <MudButton Class="custom-menu-button"
                                               Link="true"
                                               OnClick="@Logout"
                                               Color="Color.Inherit"
                                               Variant="Variant.Text">
                                        <MudText Typo="Typo.h6">@GetLabel("Logout")</MudText>
                                    </MudButton>

                                    <div style="margin-left:9px;">
                                        <MudSwitch @bind-Value="_isDarkMode"
                                                   T="bool"
                                                   LabelPlacement="Placement.Start"
                                                    >
                                            <MudText Typo="Typo.h6">@GetLabel("LDM")</MudText>
                                        </MudSwitch>
                                    </div>
                                    <MenuButton Title="@GetLabel("ChgPw")" Link="@AppRoutes.ChangePWRoute" />
                                    <MenuButton Title="@GetLabel("Config")" Link="@AppRoutes.ConfigRoute" />
                                </MudStack>
                            </ChildContent>
                        </MudMenu>
                    </div>

                </MudText>
            </MudAppBar>

            <MudMainContent Class="main-content-fill-screen">

                <div style="display:flex;height:calc(100vh - 64px - 60px);">

                    <div id="leftPanel" class="left-panel" style="width:@($"{_leftPanelWidth}px");">
                        <MainMenu />
                    </div>

                    <div id="leftSplitter" class="splitter"></div>

                    <div class="main-panel">
                        @Body
                    </div>

                    @if (_chatOpen)
                    {
                        <div id="rightSplitter" class="splitter"></div>
                        <div id="rightPanel" class="right-panel" style="width:@($"{_rightPanelWidth}px");">
                            <ServiceMenu />
                        </div>
                    }

                </div>
                
            </MudMainContent>


            <MudPaper Class="bottom-bar d-flex justify-space-between align-center" Elevation="1" Square="true">
                <div style="display: flex; align-items: center;">
                    111
                </div>
                <div style="display: flex; gap: 16px;">
                    2222222222222222222222222222222222222222222222222222222222
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                    333
                </div>
            </MudPaper>

        </MudLayout>
    }
</div>

@using GC = FrontendServer.GlobalConstants;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject ConfigService ConfS
@inject LabelService LS
@inject ThemeService TS
@inject LogoutService LgS
@inject ProtectedSessionStorage PS
@code {

    [Inject] IJSRuntime JS { get; set; } = default!;
    private DotNetObjectReference<MainLayout>? _objRef;
    private bool _chatOpen = false;
    private bool _isDarkModeBacking = false;
    private int _leftPanelWidth = 150;
    private int _rightPanelWidth = 400;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ConfS.IsInitialized)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initSplitters", _objRef);
        }
    }

    protected override void OnInitialized()
    {
        LS.OnLabelsChanged += RefreshLayout;
        TS.SetDarkMode(_isDarkMode);

        if (!ConfS.IsInitialized)
        {
            ConfS.OnInitialized += HandleConfigInitialized;
        }
    }

    private void HandleConfigInitialized() => InvokeAsync(StateHasChanged);

    private bool _isDarkMode
    {
        get => _isDarkModeBacking;
        set
        {
            _isDarkModeBacking = value;
            TS.SetDarkMode(value);
            StateHasChanged();
        }
    }

    private MudTheme _theme = new MudTheme
        {
            PaletteLight = new PaletteLight
            {
                AppbarText = "#FFFFFF",
                AppbarBackground = "#1976d2",

                Primary = "#1976d2",
                Secondary = "#e91e63",
                Background = "#f5f5f5",
                TextPrimary = "#212121",
                DrawerBackground = "#FFFF00" // "#ffffff",

            },
            PaletteDark = new PaletteDark
            {
                AppbarBackground = "#2A2D3E",   // Soft steel blue-gray
                AppbarText = "#E0E0E0",         // Muted white for comfort

                Background = "#2C2F3A", //"#1E1E2F",         // Deep but not harsh
                Surface = "#2A2D3E",            // Match or complement AppBar
                Primary = "#90CAF9",            // Soft blue (Material Blue 200)
                PrimaryContrastText = "#1E1E2F",// Text on primary buttons

                TextPrimary = "#E0E0E0",        // Light gray for standard text
                TextSecondary = "#A0A0B2",      // Dimmer for subtext
                DrawerBackground = "#2C2F3A",   // Slightly lighter for depth
            },
        };



    private void RefreshLayout() 
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetLabel(string key)
    {
        return LS.GetLabel(key);
    }

    private void ToggleChat() => _chatOpen = !_chatOpen;
    private async Task Logout() => await LgS.LogoutAsync();
    
    public void Dispose() 
    {
        LS.OnLabelsChanged -= RefreshLayout;
        ConfS.OnInitialized -= HandleConfigInitialized;
    }

    [JSInvokable]
    public async Task PanelResized(string panel, int width)
    {
        //ToDo FixMe: Implement logic to save the new width of the panels
        if (panel == "LeftPanel")
            _leftPanelWidth = width;

        if (panel == "RightPanel")
            _rightPanelWidth = width;


        // Save to session storage
        // Save to database
        // Update user preferences
    }

    public async ValueTask DisposeAsync()
    {
        _objRef?.Dispose();
    }

}