@inherits BaseComponent

@using MudBlazor
@using GC = FrontendServer.GlobalConstants;
@using FrontendServer.Base._Base;

<div style="height:100%; overflow:auto;">

    <table style="flex:1; min-height:0; table-layout:fixed; width:100%;@GetDebugBorder("pink")">

        <tbody class="mud-table-body">
            <tr class="XXmud-table-row">
                @foreach (var record in Selections.Where(x => x.IsSelected))
                {
                var dto = record.dto;

                <td @key="record.Id" style="vertical-align: top; padding: 1px; background-color:white">

                    <MudExpansionPanels MultiExpansion="true">

                        @if (record.IsValidation())
                        {
                            <MudExpansionPanel @key="record" Text=@GetValidationLabel(record) Expanded=true Style="padding:1px;" Class="@GetValidationClass(record)">
                                <ChildContent>
                                    <ErrorPanel List="record.Validation.Messages" />
                                </ChildContent>
                            </MudExpansionPanel>
                        }

                        <MudExpansionPanel Text=@GetLabel("ConfigG") Expanded="true">
                            <TitleContent>
                                <div class="expansion-title">
                                    <div style="display:flex; justify-content:space-between; align-items:center;">
                                        <Label Size="GC.TextSize.Normal" Key="ConfigG"></Label>

                                        <div style="display:flex; gap:12px; align-items:center; margin-right:10px;">
                                            <CheckboxField Width=GC.TextFieldWidth.TextShort
                                                    LangCode="Active"
                                                    @bind-Value="dto.IsActive" />
                                            <CheckboxField Width=GC.TextFieldWidth.TextShort
                                                            Class="delete-checkbox"
                                                            LangCode="Delete"
                                                            ReadOnly="!IsDeleteActive"
                                                            @bind-Value="dto.IsDelete"
                                                            @bind-Value:after="OnDeleteChanged" />
                                        </div>
                                    </div>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <div style="display: flex; flex-wrap: wrap; gap: 10px;">

                                    <div style="display:flex; align-items:flex-end; gap:5px;">
                                        <TextField Width=GC.TextFieldWidth.TextMedium
                                                    LangCode="Code"
                                                    ReadOnly="!dto.IsNew()"
                                                    PageStatus=@PageStatus
                                                    MaxLength="@GetMaxLength(nameof(dto.Code))"
                                                    Required="@IsRequired(nameof(dto.Code))"
                                                    Immediate="true"
                                                    Value="@dto.Code"
                                                    ValueChanged="@(v => CodeChanged(v, record))" />
                                    </div>

                                   

                                    <Version version=dto />

                                </div>
                            </ChildContent>
                        </MudExpansionPanel>
                        

                    </MudExpansionPanels>
                </td>
            }
            </tr>
        </tbody>

    </table>
</div>

@code {
    [Parameter] public List<ListModel<CodeTemplateDto>> Selections { get; set; } = new List<ListModel<CodeTemplateDto>>();
    [Parameter] public EventCallback Refresh { get; set; }
    
  
    private bool Expand(CodeTemplateDto.UserAccountDto account, CodeTemplateDto user)
    {
    }

    private string GetAttemptsClass() => "error-row" + DarkModeSuffix();
    
}
