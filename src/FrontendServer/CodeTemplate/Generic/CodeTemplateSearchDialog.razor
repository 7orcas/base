@inherits BasePage
 
<BaseSearchDialog Width="800px"
                  Height="400px"
                  TitleKey="UserSr"
                  SubmitAction="Submit"
                  IsValid="data.IsValid()"
                  BaseSearch="data"
                  MaxRecordsReturned="MaxRecordsReturned"
                  IsService="IsService">

    <TextField Width=GC.TextFieldWidth.TextMedium
                LangCode="Code"
                MaxLength="@GC.LenCode"
                Immediate="true"
                @ref="codeField"
                @bind-Value="data.Code" />

</BaseSearchDialog>


@using GC = FrontendServer.GlobalConstants;

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public int MaxRecordsReturned { get; set; }
    [Parameter] public bool IsService { get; set; }

    private CodeTemplateSearch data = new CodeTemplateSearch ();
    private TextField codeField;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            data = await GetAsync<CodeTemplateSearch>(GetUrl("CodeTemplateSearch"), false);
            data.MaxRecordsReturned = MaxRecordsReturned;

            await InvokeAsync(async () =>
            {
                await Task.Yield();
                await Task.Delay(100);
                await codeField!.FocusAsync();
                StateHasChanged();
            });
        }
    }

    private async Task Submit()
    {
        if (data.IsValid())
        {
            MudDialog.Close(DialogResult.Ok(data));
        }
    }

}
